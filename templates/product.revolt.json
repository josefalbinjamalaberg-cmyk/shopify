              ]
            },
            "q8": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Vilket tillbehör rekommenderas vid applicering?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Vi rekommenderar Mikrofiber Fälgborste för mekanisk bearbetning vid behov, se rekommenderat tillbehör högre upp på sidan.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
