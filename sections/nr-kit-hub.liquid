{%- comment -%}
  Färdiga paket: guided selection, not a grid of bundles.
    1. Which area?   family tabs (blocks): Exteriör · Fälg & däck · Interiör
    2. How complete? the family's kits side by side (phones: one per swipe):
       role (custom.kit_tier), name, who it is for (custom.kit_card_line),
       number of products, Paketpris, Köpta separat, Du sparar, what this kit
       adds to the previous one (snippets/nr-kit-adds; a kit that does not
       contain the previous one, e.g. Foam, lists its own contents instead),
       CTA.
  Every panel is rendered on the server (crawlable, no stale prices); the
  tabs only switch visibility. The chosen area is kept in the URL hash
  (#exterior, #falg, #interior) so it can be shared and survives reload.
  Saving = separate value (snippets/nr-ks-separate: current component prices
  minus active automatic discounts) − kit price; never compare-at.
{%- endcomment -%}

{{ 'nr-homepage.css' | asset_url | stylesheet_tag }}
{{ 'nr-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nr-shop.js' | asset_url }}" type="module" defer></script>

{%- assign ss = section.settings -%}
{%- comment -%} Horizon's view element: publishes the standard collection_viewed event for all pixels. {%- endcomment -%}
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
<div
  class="nr-shop nr-shop--kits"
  data-nr-scope
  data-nr-kit-hub
  data-collection="{{ collection.handle }}"
>
  <header class="nr-shop-intro">
    <div class="nr-shop__wrap">
      <p class="nr-shop-intro__eyebrow">{{ ss.eyebrow | default: collection.title | escape }}</p>
      <h1 class="nr-shop-intro__title">{{ ss.heading | default: collection.title | escape }}</h1>
      {%- if ss.intro != blank -%}
        <p class="nr-shop-intro__copy">{{ ss.intro | escape }}</p>
      {%- endif -%}
      {%- if ss.show_trust -%}
        <p class="nr-shop-intro__trust">
          {%- if settings.nr_trustpilot_rating != blank -%}
            <span><span class="nr-shop-intro__star" aria-hidden="true">★</span> {{ settings.nr_trustpilot_rating | replace: '.', ',' }}/5 på Trustpilot</span>
          {%- endif -%}
          <span>Skickas nästa vardag</span>
          {%- if settings.free_shipping_threshold != blank -%}
            <span>Fri frakt över {{ settings.free_shipping_threshold }} kr</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </header>

  <div class="nr-shop__wrap nr-shop__body">
    <h2 class="nr-shop-intents__heading" id="NrKitAreas-{{ section.id }}">{{ ss.tabs_heading | default: 'Vilket område?' | escape }}</h2>
    <div class="nr-chips nr-kit-tabs" role="tablist" aria-labelledby="NrKitAreas-{{ section.id }}" data-nr-kit-tabs>
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="nr-chip"
          role="tab"
          id="NrKitTab-{{ block.id }}"
          aria-controls="NrKitPanel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {% unless forloop.first %}
            tabindex="-1"
          {% endunless %}
          data-hash="{{ block.settings.hash | default: block.id | escape }}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label | escape -}}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign kits = block.settings.kits -%}
      <section
        class="nr-kit-panel"
        role="tabpanel"
        id="NrKitPanel-{{ block.id }}"
        aria-labelledby="NrKitTab-{{ block.id }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        {%- if block.settings.question != blank -%}
          <p class="nr-kit-panel__q">{{ block.settings.question | escape }}</p>
        {%- endif -%}
        <ol class="nr-kit-row nr-kit-row--{{ kits.size }}" role="list">
          {%- assign prev = nil -%}
          {%- for kit in kits -%}
            {%- liquid
              capture sep
                render 'nr-ks-separate', product: kit
              endcapture
              assign sep = sep | strip | plus: 0
              assign saving = 0
              if sep > kit.price
                assign saving = sep | minus: kit.price
              endif
              assign components = kit.metafields.custom.kit_components.value
              assign count = 0
              for c in components
                assign q = c.quantity.value | default: 1
                assign count = count | plus: q
              endfor
              assign adds = ''
              assign base_name = ''
              if prev != nil
                capture adds
                  render 'nr-kit-adds', kit: kit, base: prev
                endcapture
                assign adds = adds | strip
                assign base_name = prev.metafields.custom.kit_name.value | default: prev.title
                # A setup in between (e.g. Foam) is not a step: compare with the family's first kit.
                if adds == blank and forloop.index > 2
                  assign first_kit = kits | first
                  capture adds
                    render 'nr-kit-adds', kit: kit, base: first_kit
                  endcapture
                  assign adds = adds | strip
                  assign base_name = first_kit.metafields.custom.kit_name.value | default: first_kit.title
                endif
              endif
              assign kname = kit.metafields.custom.kit_name.value | default: kit.title
              assign tier = kit.metafields.custom.kit_tier.value
              assign who = kit.metafields.custom.kit_card_line.value
            -%}
            <li class="nr-kitc">
              <a class="nr-kitc__media" href="{{ kit.url }}" tabindex="-1" aria-hidden="true">
                {%- if kit.featured_image != blank -%}
                  {{ kit.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: '', widths: '300, 480, 720', sizes: '(min-width: 990px) 30vw, 80vw' }}
                {%- endif -%}
              </a>
              <div class="nr-kitc__body">
                {%- if tier != blank -%}
                  <p class="nr-kitc__tier">{{ tier | escape }}</p>
                {%- endif -%}
                <h3 class="nr-kitc__name">
                  <a href="{{ kit.url }}" data-nr-kit-click="{{ kit.handle }}">{{ kname | escape }}</a>
                </h3>
                {%- if who != blank -%}
                  <p class="nr-kitc__who">{{ who | escape }}</p>
                {%- endif -%}
                <p class="nr-kitc__adds">
                  {%- if adds != blank -%}
                    <span class="nr-kitc__adds-label">Allt i {{ base_name | escape }}, plus</span> {{ adds | escape }}
                  {%- else -%}
                    {%- for c in components -%}
                      {%- assign cn = c.variant.value.product.metafields.nrc.card_name.value | default: c.label.value -%}
                      {{- cn | escape -}}{%- unless forloop.last -%}{%- if forloop.rindex == 2 %} och {% else %}, {% endif -%}{%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                </p>
                <div class="nr-kitc__price">
                  <p class="nr-kitc__now"><span class="nr-kitc__price-label">Paketpris</span> {{ kit.price | money }}</p>
                  {%- if count > 0 -%}
                    <p class="nr-kitc__count">{{ count }} produkter</p>
                  {%- endif -%}
                </div>
                {%- if saving > 0 -%}
                  <p class="nr-kitc__value">
                    Köpta separat {{ sep | money }}
                    <strong>Du sparar {{ saving | money }}</strong>
                  </p>
                {%- endif -%}
                <a class="nr-btn nr-btn--primary nr-kitc__cta" href="{{ kit.url }}" data-nr-kit-click="{{ kit.handle }}">
                  Se {{ kname | escape }} <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </li>
            {%- assign prev = kit -%}
          {%- endfor -%}
        </ol>
      </section>
    {%- endfor -%}

    <nav class="nr-shop-continue" aria-label="Välj själv">
      <p class="nr-shop-continue__heading">{{ ss.self_heading | default: 'Vill du hellre välja själv?' | escape }}</p>
      <ul role="list">
        {%- for c in (1..3) -%}
          {%- assign key = 'continue_' | append: c -%}
          {%- assign col = ss[key] -%}
          {%- if col != blank -%}
            <li>
              <a href="{{ col.url }}" class="nr-shop-continue__link">
                <span>{{ col.title | escape }}</span>
                <span class="nr-shop-continue__count">{{ col.products_count }} produkter</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</div>
</collection-component>

{% schema %}
{
  "name": "NR: Färdiga paket",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Färdiga paket" },
    { "type": "text", "id": "heading", "label": "Rubrik (H1)", "default": "Rätt produkter. Redan kombinerade." },
    { "type": "textarea", "id": "intro", "label": "Ingress", "default": "Välj område och hur komplett du vill göra rutinen." },
    { "type": "checkbox", "id": "show_trust", "label": "Visa en rad med Trustpilot, leverans och fri frakt", "default": true },
    { "type": "text", "id": "tabs_heading", "label": "Rubrik för områden", "default": "Vilket område?" },
    { "type": "text", "id": "self_heading", "label": "Rubrik för länkar", "default": "Vill du hellre välja själv?" },
    { "type": "collection", "id": "continue_1", "label": "Kollektion 1" },
    { "type": "collection", "id": "continue_2", "label": "Kollektion 2" },
    { "type": "collection", "id": "continue_3", "label": "Kollektion 3" }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Område",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Flik", "default": "Exteriör" },
        { "type": "text", "id": "hash", "label": "Adress (#)", "info": "T.ex. exterior. Används i länken så att fliken kan delas." },
        { "type": "text", "id": "question", "label": "Fråga ovanför paketen", "default": "Hur komplett vill du göra rutinen?" },
        { "type": "product_list", "id": "kits", "label": "Paket (minst till störst)", "limit": 4 }
      ]
    }
  ],
  "presets": [{ "name": "NR: Färdiga paket" }]
}
{% endschema %}
