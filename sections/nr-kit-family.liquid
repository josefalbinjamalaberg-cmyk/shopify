{%- doc -%}
  Kit PDP "Vilket paket passar dig?": the kits in this kit's family
  (custom.kit_family, max three), side by side on desktop and as compact rows
  on mobile. Each kit describes itself through its own metafields
  (custom.kit_eyebrow, custom.kit_card_line); the current kit is marked
  "Ditt val" and isn't linked. Prices are each kit's own price.

  Per kit: product count (sum of component quantities), price, and – when a
  smaller kit in the same family is fully contained in it – "Allt i <kit>,
  plus:" followed by exactly the components it adds. The additions are
  computed from the component variant references, never typed by hand, so
  Litet → Mellan → Stort always shows the real difference.
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign family = kit.metafields.custom.kit_family.value
-%}

{%- if family.size > 1 -%}
  <div class="nr-kit-section nr-kit-family">
    <div class="nr-kit-container">
      <header class="nr-kit-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="nr-kit-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nr-kit-lead">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <ol
        class="nr-kit-family__list"
        role="list"
        style="--nr-kit-family: {{ family.size | at_most: 3 }};"
      >
        {%- for family_kit in family limit: 3 -%}
          {%- liquid
            assign is_current = false
            if family_kit.id == kit.id
              assign is_current = true
            endif
            assign family_eyebrow = family_kit.metafields.custom.kit_eyebrow.value
            assign family_line = family_kit.metafields.custom.kit_card_line.value
            assign fk_components = family_kit.metafields.custom.kit_components.value

            assign fk_count = 0
            assign fk_ids = '|'
            for c in fk_components
              assign q = c.quantity.value | default: 1
              assign fk_count = fk_count | plus: q
              assign fk_ids = fk_ids | append: c.variant.value.id | append: '|'
            endfor

            # Largest other kit in the family that is fully contained in this one
            assign base_kit = nil
            assign base_size = 0
            for other in family
              if other.id != family_kit.id
                assign other_components = other.metafields.custom.kit_components.value
                assign contained = true
                for oc in other_components
                  assign needle = '|' | append: oc.variant.value.id | append: '|'
                  unless fk_ids contains needle
                    assign contained = false
                  endunless
                endfor
                if contained and other_components.size > base_size and other_components.size < fk_components.size
                  assign base_kit = other
                  assign base_size = other_components.size
                endif
              endif
            endfor
          -%}
          <li class="nr-kit-family__item{% if is_current %} nr-kit-family__item--current{% endif %}">
            {%- if is_current -%}
              <p class="nr-kit-family__current">{{ section.settings.current_label | escape }}</p>
            {%- elsif family_eyebrow != blank -%}
              <p class="nr-kit-eyebrow">{{ family_eyebrow | escape }}</p>
            {%- endif -%}
            <h3 class="nr-kit-family__title">
              {%- if is_current -%}
                {{- family_kit.title | escape -}}
              {%- else -%}
                <a
                  href="{{ family_kit.url }}"
                  data-nr-event="kit_family_click"
                  data-nr-product="{{ family_kit.handle }}"
                  data-nr-source="family"
                  >{{ family_kit.title | escape }}</a
                >
              {%- endif -%}
            </h3>
            {%- if family_line != blank -%}
              <p class="nr-kit-family__line">{{ family_line | escape }}</p>
            {%- endif -%}
            <p class="nr-kit-family__facts">
              <span>{{ fk_count }} produkter</span>
              <span class="nr-kit-family__price">{{ family_kit.price | money }}</span>
            </p>
            {%- if base_kit != nil -%}
              <div class="nr-kit-family__adds">
                <p class="nr-kit-family__adds-label">Allt i {{ base_kit.title | escape }}, plus:</p>
                <ul role="list">
                  {%- assign base_ids = '|' -%}
                  {%- for bc in base_kit.metafields.custom.kit_components.value -%}
                    {%- assign base_ids = base_ids | append: bc.variant.value.id | append: '|' -%}
                  {%- endfor -%}
                  {%- for c in fk_components -%}
                    {%- assign needle = '|' | append: c.variant.value.id | append: '|' -%}
                    {%- unless base_ids contains needle -%}
                      {%- assign add_name = c.variant.value.product.title | split: ' – ' | first | split: ' - ' | first -%}
                      <li><span aria-hidden="true">+</span> {{ add_name | escape }}</li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- else -%}
              <ul
                class="nr-kit-family__contents"
                role="list"
              >
                {%- for c in fk_components -%}
                  {%- assign c_name = c.variant.value.product.title | split: ' – ' | first | split: ' - ' | first -%}
                  <li>{{ c_name | escape }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR: Paket – välj paket",
  "tag": "section",
  "class": "nr-kit-section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Paketen hämtas från metafältet Paket – paketfamilj. Sektionen döljs om färre än två paket är valda."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Vilket paket passar dig?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik"
    },
    {
      "type": "text",
      "id": "current_label",
      "label": "Etikett för aktuellt paket",
      "default": "Ditt val"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Länktext",
      "default": "Se paketet"
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – välj paket",
      "category": "Product"
    }
  ]
}
{% endschema %}
