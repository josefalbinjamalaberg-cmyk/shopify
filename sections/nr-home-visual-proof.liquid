{% comment %}
  "Rätt produkt för rätt typ av smuts" – the homepage's problem → product
  index, and its one dark media moment.

  Answers "I have this problem – what do I buy?" (the navigation's
  "Tvätta bilen steg för steg" answers how the range fits together).
  Left: one real clip (the first block that has a video). Right: every block
  as one row – the problem (large), the product that solves it, one line and
  its current price – the whole row links to the product. Product name,
  price and URL come from the block's product reference; nothing typed twice.
  Rows are not numbered: the customer picks the job they have, nobody needs
  all eight every wash.
{% endcomment %}

{%- liquid
  assign clip_block = nil
  for block in section.blocks
    if block.settings.video != blank and block.settings.product != blank
      assign clip_block = block
      break
    endif
  endfor
-%}

<div data-nr-scope class="nr-section nr-section--dark nr-proof-index">
  <div class="nr-container">
    <div class="nr-section-head nr-proof-index__head" data-nr-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="nr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="nr-body nr-body--muted">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="nr-proof-index__layout{% if clip_block != nil %} nr-proof-index__layout--media{% endif %}">
      {%- if clip_block != nil -%}
        {%- assign clip_product = clip_block.settings.product -%}
        <figure class="nr-proof-index__media" data-nr-reveal>
          <div class="nr-proof-index__video-wrap">
            <video
              data-nr-video
              class="nr-proof-index__video"
              muted
              loop
              autoplay
              playsinline
              preload="none"
              poster="{{ clip_block.settings.image | default: clip_block.settings.video.preview_image | image_url: width: 900 }}"
            >
              {%- render 'nr-video-sources', video: clip_block.settings.video -%}
            </video>
            {%- render 'nr-video-toggle', class_name: 'nr-proof-index__video-toggle' -%}
          </div>
          <figcaption class="nr-proof-index__caption">
            {{ clip_product.title | split: ' – ' | first | split: ' - ' | first }} · {{ clip_block.settings.problem }}
          </figcaption>
        </figure>
      {%- endif -%}

      <ul class="nr-proof-index__list" role="list" data-nr-reveal="stagger">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}{%- continue -%}{%- endif -%}
          <li class="nr-proof-index__item" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="nr-proof-index__row">
              <span class="nr-proof-index__problem">{{ block.settings.problem }}</span>
              <span class="nr-proof-index__product">
                <span class="nr-proof-index__name">{{ product.title | split: ' – ' | first | split: ' - ' | first }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="nr-proof-index__text">{{ block.settings.text }}</span>
                {%- endif -%}
              </span>
              <span class="nr-proof-index__price">{{ product.price | money }}</span>
              <span class="nr-proof-index__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.link_label != blank -%}
      <p class="nr-proof-index__more">
        <a href="{{ section.settings.link | default: '#' }}" class="nr-link">
          {{ section.settings.link_label }}
          <span class="nr-link__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .nr-proof-index__head {
    max-width: var(--nr-text-width);
  }

  .nr-proof-index__layout {
    display: grid;
    gap: var(--nr-space-lg);
  }

  @media screen and (min-width: 990px) {
    .nr-proof-index__layout--media {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--nr-space-xl);
      align-items: start;
    }

    .nr-proof-index__media {
      position: sticky;
      top: calc(var(--header-height, 80px) + 24px);
    }
  }

  .nr-proof-index__media {
    margin: 0;
  }

  .nr-proof-index__video-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--nr-radius-md);
    background: #1b1b1b;
  }

  @media screen and (max-width: 749px) {
    .nr-proof-index__video-wrap {
      aspect-ratio: 16 / 10;
    }
  }

  .nr-proof-index__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nr-proof-index__video-toggle {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 1;
  }

  .nr-proof-index__caption {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .nr-proof-index__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
  }

  .nr-proof-index__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .nr-proof-index__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 16px;
    grid-template-areas:
      'problem price arrow'
      'product product product';
    align-items: baseline;
    gap: 4px 16px;
    min-height: 56px;
    padding-block: 16px;
    color: #fff;
    text-decoration: none;
  }

  .nr-proof-index__problem {
    grid-area: problem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .nr-proof-index__product {
    grid-area: product;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
  }

  .nr-proof-index__name {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .nr-proof-index__text {
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.66);
  }

  .nr-proof-index__price {
    grid-area: price;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .nr-proof-index__arrow {
    grid-area: arrow;
    color: rgba(255, 255, 255, 0.6);
    transition: transform var(--nr-transition-fast), color var(--nr-transition-fast);
  }

  @media (hover: hover) {
    .nr-proof-index__row:hover .nr-proof-index__arrow {
      color: #fff;
      transform: translateX(3px);
    }

    .nr-proof-index__row:hover .nr-proof-index__problem {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 5px;
    }
  }

  .nr-proof-index__row:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media screen and (min-width: 750px) {
    .nr-proof-index__row {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr) auto 16px;
      grid-template-areas: 'problem product price arrow';
      align-items: center;
      padding-block: 20px;
    }
  }

  .nr-proof-index__more {
    margin: var(--nr-space-lg) 0 0;
  }

  .nr-section--dark .nr-proof-index__more .nr-link {
    color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Bevis i bild",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Rätt produkt för rätt typ av smuts"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Ingress (valfri)"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Länktext (valfri)",
      "info": "Pilen läggs till automatiskt."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Länk"
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Problem → produkt",
      "settings": [
        { "type": "text", "id": "problem", "label": "Problem", "default": "Trafikfilm" },
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "text", "label": "Kort förklaring" },
        { "type": "image_picker", "id": "image", "label": "Affisch för videon (valfri)" },
        { "type": "video", "id": "video", "label": "Video (valfri)", "info": "Första blocket med video visas som film bredvid listan." }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR: Bevis i bild",
      "blocks": [{ "type": "proof" }, { "type": "proof" }, { "type": "proof" }]
    }
  ]
}
{% endschema %}
