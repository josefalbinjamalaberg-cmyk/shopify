{% comment %}
  Visual proof cards — one real image (or video) per named problem, paired
  with the product that solves it. The image itself is the proof; no
  review stars or fabricated claims. A block only renders once a product
  is assigned; falls back to the product's own photo if no dedicated
  image/video is picked for the card.

  Product bottle photos use object-fit: contain (whole bottle, padded on a
  soft background) — cover would crop the bottle. Real action video
  footage (e.g. a usage clip) stays object-fit: cover since it's meant to
  fill the frame, not show a product silhouette.
{% endcomment %}

<div data-nr-scope class="nr-section nr-visual-proof">
  <div class="nr-container">
    <div class="nr-section-head nr-visual-proof__head" data-nr-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="nr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="nr-visual-proof__grid{% if section.blocks.size == 3 %} nr-visual-proof__grid--bento{% endif %}" data-nr-reveal="stagger">
      {% for block in section.blocks %}
        {%- liquid
          assign product = block.settings.product
        -%}
        {%- if product != blank -%}
          <div class="nr-visual-proof__card" {{ block.shopify_attributes }}>
            <div class="nr-visual-proof__media{% if block.settings.video == blank %} nr-visual-proof__media--product{% endif %}">
              {%- if block.settings.video != blank -%}
                <video
                  data-nr-video
                  class="nr-visual-proof__video"
                  muted
                  loop
                  autoplay
                  playsinline
                  poster="{{ block.settings.image | default: product.featured_image | image_url: width: 800 }}"
                >
                  <source src="{{ block.settings.video.sources.last.url }}" type="video/mp4">
                </video>
                {%- render 'nr-video-toggle', class_name: 'nr-visual-proof__video-toggle' -%}
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: block.settings.problem, widths: '400, 600, 800'
                }}
              {%- elsif product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: block.settings.problem, widths: '400, 600, 800'
                }}
              {%- endif -%}
            </div>
            <div class="nr-visual-proof__copy">
              <span class="nr-visual-proof__problem">{{ block.settings.problem }}</span>
              <span class="nr-visual-proof__product">{{ product.title | split: ' – ' | first | split: ' - ' | first }}</span>
              {%- if block.settings.text != blank -%}
                <p class="nr-visual-proof__text">{{ block.settings.text }}</p>
              {%- endif -%}
              <a href="{{ product.url }}" class="nr-link nr-visual-proof__link">
                Se produkt
                <span class="nr-link__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        {%- endif -%}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .nr-visual-proof__head {
    max-width: var(--nr-text-width);
  }

  .nr-visual-proof__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--nr-space-lg);
  }

  .nr-visual-proof__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .nr-visual-proof__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--nr-radius-md);
    overflow: hidden;
    background: var(--nr-surface);
  }

  .nr-visual-proof__media img,
  .nr-visual-proof__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nr-visual-proof__media--product img {
    object-fit: contain;
    padding: 24px;
  }

  .nr-visual-proof__video-toggle {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 1;
  }

  .nr-visual-proof__copy {
    padding-top: var(--nr-space-sm);
  }

  .nr-visual-proof__problem {
    display: block;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nr-visual-proof__product {
    display: block;
    margin-top: 2px;
    font-size: 0.8125rem;
    color: var(--nr-text-muted);
  }

  .nr-visual-proof__text {
    margin: var(--nr-space-xs) 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--nr-text-muted);
    max-width: 46ch;
  }

  .nr-visual-proof__link {
    display: inline-flex;
    margin-top: var(--nr-space-sm);
  }

  /* Three proofs: a bento of one large tile (first block) and two compact
     tiles beside it, media and text side by side. */
  @media screen and (min-width: 990px) {
    /* Large tile on the right: mirrors the category bento higher up the
       page so the two sections don't share the same silhouette. */
    .nr-visual-proof__grid--bento {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      grid-template-rows: auto auto;
      gap: var(--nr-space-md) var(--nr-space-lg);
    }

    .nr-visual-proof__grid--bento > :first-child {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .nr-visual-proof__grid--bento > :not(:first-child) {
      grid-column: 1;
    }

    /* The large tile follows the height of the two compact tiles instead
       of its media's intrinsic size: the media fills the space absolutely. */
    .nr-visual-proof__grid--bento > :first-child .nr-visual-proof__media {
      position: relative;
      aspect-ratio: auto;
      flex: 1;
      min-height: 320px;
    }

    .nr-visual-proof__grid--bento > :first-child .nr-visual-proof__media > :not(.nr-video-toggle) {
      position: absolute;
      inset: 0;
    }

    .nr-visual-proof__grid--bento > :first-child .nr-visual-proof__problem {
      font-size: 1.5rem;
    }

    .nr-visual-proof__grid--bento > :not(:first-child) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--nr-space-md);
      align-items: center;
      padding: var(--nr-space-sm);
      background: var(--nr-bg-soft);
      border-radius: var(--nr-radius-md);
    }

    .nr-visual-proof__grid--bento > :not(:first-child) .nr-visual-proof__media {
      aspect-ratio: 1;
    }

    .nr-visual-proof__grid--bento > :not(:first-child) .nr-visual-proof__copy {
      padding-top: 0;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .nr-visual-proof__grid--bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--nr-space-md);
    }

    .nr-visual-proof__grid--bento > :first-child {
      grid-column: 1 / -1;
    }

    .nr-visual-proof__grid--bento > :first-child .nr-visual-proof__media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Mobile: the first proof large, the other two as compact rows (media
     beside text) so three videos/images don't stack into a long scroll. */
  @media screen and (max-width: 749px) {
    .nr-visual-proof__grid {
      grid-template-columns: 1fr;
      gap: var(--nr-space-md);
    }

    .nr-visual-proof__grid--bento > :not(:first-child) {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      gap: var(--nr-space-sm);
      align-items: start;
      padding-top: var(--nr-space-md);
      border-top: 1px solid var(--nr-border);
    }

    .nr-visual-proof__grid--bento > :not(:first-child) .nr-visual-proof__media {
      aspect-ratio: 1;
    }

    .nr-visual-proof__grid--bento > :not(:first-child) .nr-visual-proof__media--product img {
      padding: 10px;
    }

    .nr-visual-proof__grid--bento > :not(:first-child) .nr-visual-proof__copy {
      padding-top: 0;
    }

    .nr-visual-proof__grid--bento > :not(:first-child) .nr-visual-proof__link {
      margin-top: var(--nr-space-xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Bevis i bild",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Rätt produkt för rätt typ av smuts"
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Bevis",
      "settings": [
        { "type": "text", "id": "problem", "label": "Problem", "default": "Trafikfilm" },
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "text", "label": "Kort förklaring" },
        { "type": "image_picker", "id": "image", "label": "Bild (valfri override)" },
        { "type": "video", "id": "video", "label": "Video (valfri, prioriteras över bild)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR: Bevis i bild",
      "blocks": [{ "type": "proof" }, { "type": "proof" }, { "type": "proof" }]
    }
  ]
}
{% endschema %}
