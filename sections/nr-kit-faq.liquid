{%- doc -%}
  Kit PDP FAQ. Three answers are generated from the kit's own data, so they
  are always correct for the kit being viewed:
    - Vad innehåller paketet?      (components, quantity, verified size)
    - Kan jag köpa produkterna separat?  (current separate total vs kit price)
    - Hur använder jag produkterna?      (links to each product's own page)
  Further questions (shipping, returns, …) are "question" blocks, shared by
  every kit using this template. Only add verified information.
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign kit_price = kit.selected_or_first_available_variant.price
  assign components = kit.metafields.custom.kit_components.value

  capture separate_total
    render 'nr-kit-separate-total', product: kit
  endcapture
  assign separate_total = separate_total | strip | plus: 0
-%}

<div class="nr-kit-section nr-kit-faq">
  <div class="nr-kit-container nr-kit-container--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="nr-kit-h2 nr-kit-faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="nr-kit-faq__list">
      {%- if components != blank -%}
        <details class="nr-kit-faq__item">
          <summary class="nr-kit-faq__question">Vad innehåller paketet?</summary>
          <div class="nr-kit-faq__answer">
            <ul role="list">
              {%- for component in components -%}
                {%- assign component_variant = component.variant.value -%}
                {%- if component_variant != blank -%}
                  <li>
                    {{ component.quantity.value | default: 1 }} st {{ component_variant.product.title | escape }}
                    {%- if component.size != blank %} ({{ component.size.value | escape }}){% endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </details>

        {%- if separate_total > kit_price -%}
          <details class="nr-kit-faq__item">
            <summary class="nr-kit-faq__question">Kan jag köpa produkterna separat?</summary>
            <div class="nr-kit-faq__answer">
              <p>
                Ja, alla produkter i paketet säljs även styckvis. Köpta separat kostar de i dag
                {{ separate_total | money }} – i paketet betalar du {{ kit_price | money }}.
              </p>
            </div>
          </details>
        {%- endif -%}

        <details class="nr-kit-faq__item">
          <summary class="nr-kit-faq__question">Hur använder jag produkterna?</summary>
          <div class="nr-kit-faq__answer">
            <p>Varje produkt har en utförlig bruksanvisning på sin produktsida:</p>
            <ul role="list">
              {%- for component in components -%}
                {%- assign component_product = component.variant.value.product -%}
                {%- if component_product != blank -%}
                  <li>
                    <a href="{{ component_product.url }}">{{ component_product.title | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Kit-specific questions: custom.kit_faq, one "Fråga | Svar" per line {%- endcomment -%}
      {%- assign kit_faq = kit.metafields.custom.kit_faq.value | newline_to_br | split: '<br />' -%}
      {%- for line in kit_faq -%}
        {%- assign parts = line | strip | split: ' | ' -%}
        {%- if parts.size >= 2 -%}
          <details class="nr-kit-faq__item">
            <summary class="nr-kit-faq__question">{{ parts[0] | strip | escape }}</summary>
            <div class="nr-kit-faq__answer"><p>{{ parts[1] | strip | escape }}</p></div>
          </details>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Safety: each component's own most important warning (pdp.safety_note) {%- endcomment -%}
      {%- assign safety_count = 0 -%}
      {%- capture safety_items -%}
        {%- for component in components -%}
          {%- assign component_product = component.variant.value.product -%}
          {%- assign safety = component_product.metafields.pdp.safety_note.value -%}
          {%- if safety != blank -%}
            {%- assign safety_count = safety_count | plus: 1 -%}
            {%- assign safety_name = component_product.title | split: ' – ' | first | split: ' - ' | first -%}
            <li><strong>{{ safety_name | escape }}:</strong> {{ safety | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if safety_count > 0 -%}
        <details class="nr-kit-faq__item">
          <summary class="nr-kit-faq__question">Säkerhetsinformation</summary>
          <div class="nr-kit-faq__answer">
            <ul role="list">{{ safety_items }}</ul>
            <p>Läs alltid produktetiketten och säkerhetsdatabladet före användning.</p>
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Delivery from the global Frakt & leverans settings {%- endcomment -%}
      {%- if settings.delivery_time_text != blank or settings.free_shipping_threshold > 0 -%}
        <details class="nr-kit-faq__item">
          <summary class="nr-kit-faq__question">Leverans</summary>
          <div class="nr-kit-faq__answer">
            <p>
              {%- if settings.delivery_time_text != blank -%}{{ settings.delivery_time_text | escape }}.{% endif %}
              {% if settings.free_shipping_threshold > 0 -%}
                Fri frakt över {{ settings.free_shipping_threshold }} kr
                {%- assign threshold_cents = settings.free_shipping_threshold | times: 100 -%}
                {%- if kit_price >= threshold_cents %} – gäller det här paketet{% endif -%}.
              {%- endif -%}
            </p>
          </div>
        </details>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          <details
            class="nr-kit-faq__item"
            {{ block.shopify_attributes }}
          >
            <summary class="nr-kit-faq__question">{{ block.settings.question | escape }}</summary>
            <div class="nr-kit-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NR: Paket – frågor",
  "tag": "section",
  "class": "nr-kit-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Vanliga frågor"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Fråga",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Fråga"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Svar",
          "info": "Endast verifierad information."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – frågor",
      "category": "Product"
    }
  ]
}
{% endschema %}
