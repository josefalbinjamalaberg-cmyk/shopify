{%- doc -%}
  Kit page (v3): compact FAQ.
    - custom.kit_faq: one "Fråga | Svar" per line, verified answers only
    - Leverans: generated from the global Frakt & leverans settings
    - extra static questions as blocks (e.g. Retur)
  Native <details> (keyboard + touch), single column, same left edge as the
  rest of the page, readable line length.
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign faq_lines = kit.metafields.custom.kit_faq.value | newline_to_br | split: '<br />'
  assign threshold = settings.free_shipping_threshold
-%}

<div class="section section--page-width nr-kp-section nr-kp-section--tight">
  <div class="nr-kp-inner nr-kp-inner--text">
    <h2 class="nr-kp-h2">{{ section.settings.heading | escape }}</h2>
    <div class="nr-kp-faq">
      {%- for line in faq_lines -%}
        {%- assign parts = line | strip | split: ' | ' -%}
        {%- if parts.size >= 2 -%}
          <details class="nr-kp-faq__item">
            <summary class="nr-kp-faq__q">{{ parts[0] | strip | escape }}</summary>
            <div class="nr-kp-faq__a"><p>{{ parts[1] | strip | escape }}</p></div>
          </details>
        {%- endif -%}
      {%- endfor -%}

      {%- if settings.delivery_time_text != blank or threshold > 0 -%}
        <details class="nr-kp-faq__item">
          <summary class="nr-kp-faq__q">Leverans</summary>
          <div class="nr-kp-faq__a">
            <p>
              {%- if settings.delivery_time_text != blank -%}{{ settings.delivery_time_text | escape }}.{% endif %}
              {% if threshold > 0 -%}Fri frakt över {{ threshold }}&nbsp;kr.{%- endif -%}
            </p>
          </div>
        </details>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          <details
            class="nr-kp-faq__item"
            {{ block.shopify_attributes }}
          >
            <summary class="nr-kp-faq__q">{{ block.settings.question | escape }}</summary>
            <div class="nr-kp-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NR Kit: vanliga frågor",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vanliga frågor" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Fråga",
      "settings": [
        { "type": "text", "id": "question", "label": "Fråga" },
        { "type": "richtext", "id": "answer", "label": "Svar" }
      ]
    }
  ],
  "presets": [{ "name": "NR Kit: vanliga frågor", "category": "Product" }]
}
{% endschema %}
