{%- doc -%}
  Kit page (v3): "Så använder du kitet" – three compact steps.

  Each step block: title, text (written from the products' own verified
  instructions) and the kit products it uses (product_list) – shown as small
  real packshots so the customer sees WHICH products belong to the step.
  Optional real clip: the first VIDEO in the chosen product's pdp.demo_media
  (the same clip used on that product's own page), with its caption.
  No clip is shown when none exists – never a placeholder or a stock image.
{%- enddoc -%}

{%- liquid
  assign clip = nil
  if section.settings.video_product != blank
    for media in section.settings.video_product.metafields.pdp.demo_media.value
      if media.media_type == 'video'
        assign clip = media
        break
      endif
    endfor
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <div class="section section--page-width nr-kp-section nr-kp-section--soft">
    <div class="nr-kp-inner">
      <header class="nr-kp-head">
        <h2 class="nr-kp-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lead != blank -%}
          <p class="nr-kp-lead">{{ section.settings.lead | escape }}</p>
        {%- endif -%}
      </header>

      <div class="nr-kp-usage{% if clip != nil %} nr-kp-usage--with-clip{% endif %}">
        <ol
          class="nr-kp-steps"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li
              class="nr-kp-step"
              {{ block.shopify_attributes }}
            >
              <span
                class="nr-kp-step__index"
                aria-hidden="true"
              >
                {{- forloop.index -}}
              </span>
              <div class="nr-kp-step__body">
                <h3 class="nr-kp-step__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="nr-kp-step__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {%- if block.settings.products != blank -%}
                  <ul
                    class="nr-kp-step__products"
                    role="list"
                  >
                    {%- for step_product in block.settings.products -%}
                      {%- assign step_name = step_product.title | split: ' – ' | first | split: ' - ' | first -%}
                      <li>
                        <a href="{{ step_product.url }}">
                          <span class="nr-kp-step__thumb">
                            {%- if step_product.featured_image != blank -%}
                              {{
                                step_product.featured_image
                                | image_url: width: 96
                                | image_tag: loading: 'lazy', alt: '', widths: '48, 96', sizes: '40px'
                              }}
                            {%- endif -%}
                          </span>
                          <span>{{ step_name | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>

        {%- if clip != nil -%}
          <figure class="nr-kp-clip">
            <div class="nr-kp-clip__media">
              {{
                clip
                | video_tag:
                  image_size: '960x',
                  controls: true,
                  muted: true,
                  playsinline: true,
                  preload: 'none'
              }}
            </div>
            {%- if section.settings.video_caption != blank -%}
              <figcaption class="nr-kp-clip__caption">{{ section.settings.video_caption | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="nr-kp-note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR Kit: användning",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Så använder du kitet" },
    { "type": "text", "id": "lead", "label": "Ingress" },
    { "type": "product", "id": "video_product", "label": "Visa riktig film från produkt", "info": "Första filmen i produktens PDP-demo (pdp.demo_media). Inget visas om film saknas." },
    { "type": "text", "id": "video_caption", "label": "Filmtext" },
    { "type": "text", "id": "note", "label": "Notering under stegen" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Steg",
      "settings": [
        { "type": "text", "id": "title", "label": "Rubrik" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Endast verifierade anvisningar." },
        { "type": "product_list", "id": "products", "label": "Produkter i steget", "limit": 4 }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "NR Kit: användning", "category": "Product" }]
}
{% endschema %}
