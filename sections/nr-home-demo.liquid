{% comment %}
  Product demonstration section. Embeds the theme's native video block
  (content_for 'block') for real Shopify-hosted playback, captions and
  poster support — falls back to the theme's own video placeholder until a
  video is uploaded, exactly like the Alkastrike result-video section.

  The caption under the video is static copy (not a merchant setting)
  since it names a verified clip duration. Update the text by hand if the
  video block's source is ever swapped for a different clip. It sits below
  the video rather than as a label on top of the footage.
{% endcomment %}

<div data-nr-scope class="nr-section nr-demo">
  <div class="nr-container">
    <div class="nr-section-head nr-section-head--center" data-nr-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="nr-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="nr-body nr-body--muted">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="nr-link nr-demo__link">
          {{ section.settings.button_label }}
          <span class="nr-link__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    <figure class="nr-demo__media" data-nr-reveal>
      {% content_for 'block', type: 'video', id: 'video' %}
      <figcaption class="nr-demo__caption">Förtvätt i verkligheten, 13 sekunder.</figcaption>
    </figure>
  </div>
</div>

{% stylesheet %}
  .nr-demo__link {
    margin-top: var(--nr-space-sm);
  }

  .nr-demo__media {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .nr-demo__media > :first-child {
    border-radius: var(--nr-radius-md);
    overflow: hidden;
  }

  .nr-demo__caption {
    margin-top: var(--nr-space-sm);
    text-align: center;
    font-size: 0.875rem;
    color: var(--nr-text-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Produktdemonstration",
  "tag": "section",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "video" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Se skillnaden i processen"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Rätt produkt ska inte bara låta bra. Den ska vara enkel att förstå, använda och bedöma i verklig användning."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knapptext",
      "default": "Se våra produkter i användning"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knapplänk"
    }
  ],
  "presets": [
    {
      "name": "NR: Produktdemonstration",
      "blocks": [{ "type": "video" }]
    }
  ]
}
{% endschema %}
