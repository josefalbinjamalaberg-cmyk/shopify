{%- doc -%}
  Kit PDP routine. Groups the kit's components by their "Uppgift i rutinen"
  (nr_kit_component.group), in component order.

  Hidden when the kit covers fewer than two tasks (nothing to explain).

  Two honest modes, chosen per kit by custom.kit_routine_verified:
  - true:  "Din tvättrutin" — numbered steps with a thin connector, i.e. a
           chronological routine. Only use when the order is confirmed.
  - false: "Vad varje del löser" — the same groups WITHOUT numbers or arrows,
           so no usage order is implied that hasn't been verified.

  Preferred mode – custom.kit_routine (JSON), written per kit from verified
  product instructions:
    { "heading": "Din exteriörrutin", "lead": "…",
      "stages": [ { "label": "Före handtvätten",
                    "tasks": [ { "title": "Asfalt & tjära", "items": [1],
                                 "text": "…" } ] } ] }
  "items" are positions in custom.kit_components (1 = first component), so
  images, names and links always come from the same product references.
  Stages are joined with ↓ (a verified before/after relation); several tasks
  inside one stage sit side by side (no order implied between them). Several
  items inside one task are joined with "+" (used together, e.g. Foam
  Cannon + Foamtastic). Without the JSON the section falls back to grouping
  by component group (below).
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign components = kit.metafields.custom.kit_components.value
  assign routine = kit.metafields.custom.kit_routine.value
-%}

{%- if components != blank and routine != blank and routine.stages.size > 0 -%}
  <div class="nr-kit-section nr-kit-section--soft nr-kit-routine nr-kit-routine--story">
    <div class="nr-kit-container">
      <header class="nr-kit-head">
        <h2 class="nr-kit-h2">{{ routine.heading | default: section.settings.heading_tasks | escape }}</h2>
        {%- if routine.lead != blank -%}
          <p class="nr-kit-lead">{{ routine.lead | escape }}</p>
        {%- endif -%}
      </header>

      <ol
        class="nr-kit-story"
        role="list"
      >
        {%- for stage in routine.stages -%}
          <li class="nr-kit-story__stage">
            {%- if stage.label != blank -%}
              <p class="nr-kit-story__label">
                {%- if routine.numbered -%}
                  <span aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }} </span>
                {%- endif -%}
                {{- stage.label | escape -}}
              </p>
            {%- endif -%}
            <ul
              class="nr-kit-story__tasks"
              role="list"
              style="--nr-kit-tasks: {{ stage.tasks.size }};"
            >
              {%- for task in stage.tasks -%}
                <li class="nr-kit-story__task{% if task.items.size == 0 %} nr-kit-story__task--result{% endif %}">
                  {%- if task.items.size > 0 -%}
                  <div class="nr-kit-story__items">
                    {%- for n in task.items -%}
                      {%- liquid
                        assign position = n | minus: 1
                        assign component = components[position]
                        assign component_variant = component.variant.value
                        assign component_product = component_variant.product
                        assign component_image = component_variant.image | default: component_product.featured_image
                        assign short_name = component_product.title | split: ' – ' | first | split: ' - ' | first
                      -%}
                      {%- if component_variant != blank -%}
                        {%- unless forloop.first -%}
                          <span
                            class="nr-kit-story__plus"
                            aria-hidden="true"
                            >+</span
                          >
                        {%- endunless -%}
                        <a
                          class="nr-kit-story__item"
                          href="{{ component_product.url }}"
                        >
                          <span class="nr-kit-media nr-kit-story__media">
                            {%- if component_image != blank -%}
                              {{
                                component_image
                                | image_url: width: 240
                                | image_tag: loading: 'lazy', alt: '', widths: '120, 180, 240', sizes: '96px'
                              }}
                            {%- endif -%}
                          </span>
                          <span class="nr-kit-story__name">{{ short_name | escape }}</span>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- endif -%}
                  <h3 class="nr-kit-story__title">{{ task.title | escape }}</h3>
                  {%- if task.text != blank -%}
                    <p class="nr-kit-story__text">{{ task.text | escape }}</p>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endfor -%}
      </ol>
      {%- if routine.note != blank -%}
        <p class="nr-kit-story__note">{{ routine.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
{%- liquid
  assign verified = kit.metafields.custom.kit_routine_verified.value

  # Ordered, de-duplicated list of groups (a group appears once, at the
  # position of its first component). Built as "A§B§C" — no leading or
  # trailing separator, so split never yields an empty group.
  assign group_list = ''
  for component in components
    assign group_name = component.group.value | strip
    if group_name != blank
      assign haystack = '§' | append: group_list | append: '§'
      assign needle = '§' | append: group_name | append: '§'
      unless haystack contains needle
        if group_list == blank
          assign group_list = group_name
        else
          assign group_list = group_list | append: '§' | append: group_name
        endif
      endunless
    endif
  endfor
  assign groups = group_list | split: '§'
-%}

{%- if components != blank and groups.size > 1 -%}
  <div class="nr-kit-section nr-kit-section--soft nr-kit-routine{% if verified %} nr-kit-routine--sequence{% endif %}">
    <div class="nr-kit-container">
      <header class="nr-kit-head">
        <h2 class="nr-kit-h2">
          {%- if verified -%}
            {{- section.settings.heading_sequence | escape -}}
          {%- else -%}
            {{- section.settings.heading_tasks | escape -}}
          {%- endif -%}
        </h2>
        {%- if verified -%}
          {%- if section.settings.subheading_sequence != blank -%}
            <p class="nr-kit-lead">{{ section.settings.subheading_sequence | escape }}</p>
          {%- endif -%}
        {%- elsif section.settings.subheading_tasks != blank -%}
          <p class="nr-kit-lead">{{ section.settings.subheading_tasks | replace: '[antal]', groups.size | escape }}</p>
        {%- endif -%}
      </header>

      <ol
        class="nr-kit-routine__list"
        role="list"
      >
        {%- for group_name in groups -%}
          <li class="nr-kit-routine__step">
            {%- if verified -%}
              <span
                class="nr-kit-routine__index"
                aria-hidden="true"
              >
                {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
              </span>
            {%- endif -%}
            <h3 class="nr-kit-routine__title">{{ group_name | escape }}</h3>
            <ul
              class="nr-kit-routine__products"
              role="list"
            >
              {%- for component in components -%}
                {%- assign component_group = component.group.value | strip -%}
                {%- if component_group == group_name -%}
                  {%- liquid
                    assign component_variant = component.variant.value
                    assign component_product = component_variant.product
                    assign component_image = component_variant.image | default: component_product.featured_image
                    assign short_name = component_product.title | split: ' – ' | first | split: ' - ' | first
                    assign role = component.role.value | default: component_product.metafields.custom.product_category.value
                  -%}
                  {%- if component_variant != blank -%}
                    <li class="nr-kit-routine__product">
                      <span class="nr-kit-media nr-kit-routine__media">
                        {%- if component_image != blank -%}
                          {{
                            component_image
                            | image_url: width: 120
                            | image_tag: loading: 'lazy', alt: '', widths: '60, 120', sizes: '56px'
                          }}
                        {%- endif -%}
                      </span>
                      <span class="nr-kit-routine__text">
                        <span class="nr-kit-routine__name">{{ short_name | escape }}</span>
                        {%- if role != blank -%}
                          <span class="nr-kit-routine__role">{{ role | escape }}</span>
                        {%- endif -%}
                      </span>
                    </li>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "NR: Paket – rutin",
  "tag": "section",
  "class": "nr-kit-section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Grupperas efter komponenternas \"Uppgift i rutinen\". Numrerade steg visas bara när paketets metafält \"Paket – rutinordning bekräftad\" är på."
    },
    {
      "type": "text",
      "id": "heading_tasks",
      "label": "Rubrik (ordning ej bekräftad)",
      "default": "Vad varje del löser"
    },
    {
      "type": "text",
      "id": "subheading_tasks",
      "label": "Underrubrik (ordning ej bekräftad)",
      "info": "[antal] ersätts med antalet uppgifter.",
      "default": "Paketet täcker [antal] uppgifter i en utvändig tvätt."
    },
    {
      "type": "text",
      "id": "heading_sequence",
      "label": "Rubrik (ordning bekräftad)",
      "default": "Din tvättrutin"
    },
    {
      "type": "text",
      "id": "subheading_sequence",
      "label": "Underrubrik (ordning bekräftad)",
      "default": "Så används produkterna i paketet, steg för steg."
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – rutin",
      "category": "Product"
    }
  ]
}
{% endschema %}
