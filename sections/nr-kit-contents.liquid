{%- doc -%}
  Kit PDP 02 "Det här får du": every component of the kit as an editorial row.

  Each row is built from ONE nr_kit_component metaobject; name, image, type and
  link all come from its variant's product (a single Shopify reference – no
  manually maintained arrays):
    number        position in custom.kit_components
    image / link  variant image, else product featured image → product page
    type          product's pdp.type_label, else the component's role
    quantity/size component quantity + verified size
    why           custom.kit_component_notes[n] (per kit: why it is in THIS kit),
                  else the component's generic purpose
  No per-component price or add-to-cart: the customer is buying the kit.
  ≤ 4 components: a horizontal sequence on desktop; more: two columns of rows.
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign components = kit.metafields.custom.kit_components.value
  assign notes = kit.metafields.custom.kit_component_notes.value
  assign count = components.size
  assign layout = 'rows'
  if count <= 4
    assign layout = 'sequence'
  endif
-%}

{%- if components != blank -%}
  <div
    class="nr-kit-section nr-kit-contents nr-kit-contents--{{ layout }}"
    style="--nr-kit-count: {{ count }};"
  >
    <div class="nr-kit-container">
      <header class="nr-kit-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="nr-kit-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nr-kit-lead">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <ol
        class="nr-kit-contents__list"
        role="list"
      >
        {%- for component in components -%}
          {%- liquid
            assign component_variant = component.variant.value
            assign component_product = component_variant.product
            assign component_url = component_product.url
            if component_product.variants.size > 1
              assign component_url = component_variant.url
            endif
            assign component_image = component_variant.image | default: component_product.featured_image
            assign short_name = component_product.title | split: ' – ' | first | split: ' - ' | first
            assign type = component_product.metafields.pdp.type_label.value | default: component.role.value
            assign quantity = component.quantity.value | default: 1
            assign index = forloop.index | prepend: '0' | slice: -2, 2
            assign note_index = forloop.index0
            assign why = notes[note_index] | default: component.purpose.value
          -%}
          {%- if component_variant != blank -%}
            <li class="nr-kit-contents__item">
              <a
                href="{{ component_url }}"
                class="nr-kit-media nr-kit-contents__media"
                tabindex="-1"
                aria-hidden="true"
              >
                {%- if component_image != blank -%}
                  {{
                    component_image
                    | image_url: width: 640
                    | image_tag:
                      loading: 'lazy',
                      alt: '',
                      widths: '160, 240, 320, 480, 640',
                      sizes: '(min-width: 990px) 280px, (min-width: 750px) 30vw, 120px'
                  }}
                {%- endif -%}
              </a>
              <div class="nr-kit-contents__body">
                <p
                  class="nr-kit-contents__index"
                  aria-hidden="true"
                >
                  {{- index -}}
                </p>
                <h3 class="nr-kit-contents__name">
                  <a href="{{ component_url }}">{{ short_name | escape }}</a>
                </h3>
                {%- if type != blank -%}
                  <p class="nr-kit-contents__role">{{ type | escape }}</p>
                {%- endif -%}
                <p class="nr-kit-contents__meta">
                  {{- quantity }} st
                  {%- if component.size != blank %} · {{ component.size.value | escape }}{% endif -%}
                </p>
                {%- if why != blank -%}
                  <p class="nr-kit-contents__purpose">{{ why | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR: Paket – innehåll",
  "tag": "section",
  "class": "nr-kit-section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Innehållet hämtas från paketets metafält Paket – innehåll. Sektionen döljs om det är tomt."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Det här får du"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik",
      "default": "Varje produkt har en tydlig uppgift i paketet."
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – innehåll",
      "category": "Product"
    }
  ]
}
{% endschema %}
