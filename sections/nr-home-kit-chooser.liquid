{% comment %}
  "Hitta rätt paket": the three exterior kits as three different intentions,
  not three equal cards.

    GRUNDEN       light, clean packshot, whitespace        (style: light)
    FOAM SETUP    real foam footage as the environment     (style: foam)
    HELA RUTINEN  dark, every product on one shelf         (style: system)

  Desktop: the system kit is the tall panel on the right; the other two
  stack on the left. Phones: one column in the block order.

  Per kit, and nothing more: role, name, who it is for, number of products,
  price, what the contents cost one by one, saving, CTA, and "Visa vad som
  ingår", a strip of the real components (image, name, one-line role from
  pdp.type_label).

  Data: the kit product (custom.kit_name, custom.kit_components). Separate
  value from snippets/nr-ks-separate (current component prices, minus any
  active automatic discount on the same products), so the saving is never
  overstated and never uses compare-at. A block without a product renders
  nothing; the section hides when no block has one. Keeps #nr-bundle.
{% endcomment %}

{%- liquid
  assign has_any_kit = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_any_kit = true
    endif
  endfor
-%}

{%- if has_any_kit -%}
  <div id="nr-bundle" data-nr-scope class="nr-section nr-kits">
    <div class="nr-container">
      <div class="nr-section-head nr-kits__head" data-nr-reveal>
        {%- if section.settings.heading != blank -%}
          <h2 class="nr-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="nr-body nr-body--muted">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <ul class="nr-kits__grid" role="list" data-nr-reveal="stagger">
        {%- for block in section.blocks -%}
          {%- assign kit = block.settings.product -%}
          {%- if kit == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            capture separate
              render 'nr-ks-separate', product: kit
            endcapture
            assign separate = separate | strip | plus: 0
            assign saving = 0
            if separate > kit.price
              assign saving = separate | minus: kit.price
            endif
            assign components = kit.metafields.custom.kit_components.value
            assign count = 0
            for c in components
              assign q = c.quantity.value | default: 1
              assign count = count | plus: q
            endfor
            assign kit_name = kit.metafields.custom.kit_name.value | default: kit.title
            assign style = block.settings.style | default: 'light'
            assign strip_id = 'NrKitStrip-' | append: block.id
          -%}
          <li class="nr-kits__cell nr-kits__cell--{{ style }}" {{ block.shopify_attributes }}>
            <article class="nr-kitx nr-kitx--{{ style }}" aria-labelledby="NrKitName-{{ block.id }}">
              <div class="nr-kitx__env" aria-hidden="true">
                {%- if style == 'foam' and block.settings.video != blank -%}
                  <video
                    data-nr-video
                    class="nr-kitx__video"
                    muted
                    loop
                    playsinline
                    preload="none"
                    {% if block.settings.video.preview_image != blank %}
                      poster="{{ block.settings.video.preview_image | image_url: width: 1100 }}"
                    {% endif %}
                  >
                    {%- render 'nr-video-sources', video: block.settings.video -%}
                  </video>
                {%- elsif style == 'system' and components != blank -%}
                  <span class="nr-kitx__shelf">
                    {%- for c in components -%}
                      {%- assign cp = c.variant.value.product -%}
                      {%- if cp.featured_image != blank -%}
                        <span class="nr-kitx__shelf-item">
                          {{
                            cp.featured_image
                            | image_url: width: 240
                            | image_tag: loading: 'lazy', alt: '', widths: '120, 180, 240', sizes: '(min-width: 990px) 80px, 12vw'
                          }}
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- else -%}
                  {%- assign env_image = block.settings.image | default: kit.featured_image -%}
                  {%- if env_image != blank -%}
                    <span class="nr-kitx__packshot">
                      {{
                        env_image
                        | image_url: width: 800
                        | image_tag: loading: 'lazy', alt: '', widths: '300, 500, 800', sizes: '(min-width: 990px) 260px, 40vw'
                      }}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <div class="nr-kitx__body">
                {%- if block.settings.badge != blank -%}
                  <p class="nr-kitx__role">{{ block.settings.badge | escape }}</p>
                {%- endif -%}
                <h3 class="nr-kitx__name" id="NrKitName-{{ block.id }}">{{ kit_name | escape }}</h3>
                {%- if block.settings.subheading != blank -%}
                  <p class="nr-kitx__for">{{ block.settings.subheading | escape }}</p>
                {%- endif -%}

                <p class="nr-kitx__price">
                  <span class="nr-kitx__price-now">{{ kit.price | money }}</span>
                  {%- if count > 0 -%}
                    <span class="nr-kitx__count">{{ count }} produkter</span>
                  {%- endif -%}
                </p>
                {%- if saving > 0 -%}
                  <p class="nr-kitx__value">
                    Köpta separat {{ separate | money }}
                    <strong>Du sparar {{ saving | money }}</strong>
                  </p>
                {%- endif -%}

                <div class="nr-kitx__actions">
                  <a
                    href="{{ kit.url }}"
                    class="nr-btn nr-btn--primary nr-kitx__cta"
                    data-nr-event="kit_section_click"
                    data-nr-product="{{ kit.handle }}"
                    data-nr-source="home_kits"
                  >
                    {{- block.settings.button_label | default: 'Se kitet' | escape }}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                  {%- if components != blank -%}
                    <button
                      type="button"
                      class="nr-kitx__toggle"
                      aria-expanded="false"
                      aria-controls="{{ strip_id }}"
                      data-nr-kitx-toggle
                      hidden
                    >
                      <span data-nr-kitx-toggle-label>Visa vad som ingår</span>
                      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                  {%- endif -%}
                </div>

                {%- if components != blank -%}
                  <ul class="nr-kitx__strip" id="{{ strip_id }}" role="list" data-nr-kitx-strip>
                    {%- for c in components -%}
                      {%- liquid
                        assign cp = c.variant.value.product
                        assign cname = cp.title | replace: ' - ', ' – ' | split: ' – ' | first | strip
                        assign csize = c.size.value
                        assign crole = cp.metafields.pdp.type_label.value
                        assign cq = c.quantity.value | default: 1
                      -%}
                      <li class="nr-kitx__part">
                        <span class="nr-kitx__part-media">
                          {%- if cp.featured_image != blank -%}
                            {{
                              cp.featured_image
                              | image_url: width: 160
                              | image_tag: loading: 'lazy', alt: '', widths: '80, 120, 160', sizes: '48px'
                            }}
                          {%- endif -%}
                        </span>
                        <span class="nr-kitx__part-text">
                          <span class="nr-kitx__part-name">
                            {%- if cq > 1 %}{{ cq }} × {% endif -%}
                            {{- cname | escape -}}
                            {%- if csize != blank %} <span class="nr-kitx__part-size">{{ csize | escape }}</span>{% endif -%}
                          </span>
                          {%- if crole != blank -%}
                            <span class="nr-kitx__part-role">{{ crole | escape }}</span>
                          {%- endif -%}
                        </span>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.more_label != blank -%}
        <p class="nr-kits__more">
          <a
            href="{{ section.settings.more_link | default: routes.collections_url }}"
            class="nr-link"
            data-nr-event="kit_section_click"
            data-nr-source="home_kits_all"
          >
            {{- section.settings.more_label | escape -}}
            <span class="nr-link__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .nr-kits__head {
    max-width: var(--nr-text-width);
  }

  .nr-kits .nr-section-head .nr-body {
    margin-top: 12px;
  }

  /* Desktop: system kit tall on the right, the other two stacked left. */
  .nr-kits__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    grid-auto-rows: minmax(0, auto);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nr-kits__cell {
    display: flex;
    min-width: 0;
  }

  .nr-kits__cell--system {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .nr-kitx {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    overflow: hidden;
    border-radius: var(--nr-radius-sm);
    isolation: isolate;
  }

  .nr-kitx__env,
  .nr-kitx__shelf,
  .nr-kitx__shelf-item {
    min-width: 0;
  }

  .nr-kitx__body {
    position: relative;
    z-index: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(24px, 2.6vw, 40px);
  }

  .nr-kitx__role {
    margin: 0 0 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kitx-muted);
  }

  .nr-kitx__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .nr-kitx__for {
    margin: 10px 0 0;
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--kitx-muted);
  }

  .nr-kitx__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: 22px 0 0;
  }

  .nr-kitx__price-now {
    font-size: 1.375rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .nr-kitx__count {
    font-size: 0.875rem;
    color: var(--kitx-muted);
  }

  .nr-kitx__value {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin: 4px 0 0;
    font-size: 0.875rem;
    color: var(--kitx-muted);
    font-variant-numeric: tabular-nums;
  }

  .nr-kitx__value strong {
    font-weight: 600;
    color: var(--kitx-save);
  }

  .nr-kitx__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 22px;
  }

  .nr-kitx__toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .nr-kitx__toggle[hidden] {
    display: none;
  }

  .nr-kitx__toggle svg {
    width: 16px;
    height: 16px;
    transition: transform var(--nr-transition-fast);
  }

  .nr-kitx__toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .nr-kitx__toggle:focus-visible,
  .nr-kitx__cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* "Vad som ingår": a horizontal strip of the real components. */
  .nr-kitx__strip {
    display: flex;
    gap: 10px;
    width: 100%;
    margin: 18px 0 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .nr-kitx__strip::-webkit-scrollbar {
    display: none;
  }

  [data-nr-kitx-ready] .nr-kitx__strip:not(.is-open) {
    display: none;
  }

  .nr-kitx__part {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 240px;
    padding: 8px 14px 8px 8px;
    border: 1px solid var(--kitx-line);
    border-radius: var(--nr-radius-sm);
    scroll-snap-align: start;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nr-kitx__strip.is-open .nr-kitx__part {
      animation: nr-kitx-in 260ms var(--nr-ease-out) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
  }

  @keyframes nr-kitx-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .nr-kitx__part-media {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 2px;
    background: #f1f0ec;
    overflow: hidden;
  }

  .nr-kitx__part-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .nr-kitx__part-text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .nr-kitx__part-name {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .nr-kitx__part-size,
  .nr-kitx__part-role {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--kitx-muted);
  }

  .nr-kitx__part-role {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- GRUNDEN: light, clean, whitespace ---------- */
  .nr-kitx--light {
    --kitx-muted: var(--nr-text-muted);
    --kitx-line: var(--nr-border);
    --kitx-save: var(--nr-save);
    background: var(--nr-bg-soft);
    color: var(--nr-text);
  }

  .nr-kitx--light .nr-kitx__env {
    position: absolute;
    top: 0;
    right: 0;
    width: 44%;
    height: min(100%, 420px);
  }

  .nr-kitx--light .nr-kitx__body > :not(.nr-kitx__strip) {
    max-width: 56%;
  }

  .nr-kitx__packshot {
    position: absolute;
    inset: 12% 10% 12% 4%;
  }

  .nr-kitx__packshot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* ---------- FOAM SETUP: the real foam as the environment ---------- */
  .nr-kitx--foam {
    --kitx-muted: rgba(255, 255, 255, 0.78);
    --kitx-line: rgba(255, 255, 255, 0.28);
    --kitx-save: var(--nr-save-on-dark);
    background: #2a2d30;
    color: #fff;
  }

  .nr-kitx--foam .nr-kitx__env {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .nr-kitx--foam .nr-kitx__env::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(14, 16, 18, 0.82) 0%, rgba(14, 16, 18, 0.55) 55%, rgba(14, 16, 18, 0.2) 100%);
  }

  .nr-kitx__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nr-kitx--foam .nr-btn--primary,
  .nr-kitx--system .nr-btn--primary {
    background: #fff;
    color: var(--nr-text);
    border-color: #fff;
  }

  .nr-kitx--foam .nr-btn--primary:hover,
  .nr-kitx--system .nr-btn--primary:hover {
    background: #e9e9e9;
    border-color: #e9e9e9;
  }

  .nr-kitx--foam .nr-kitx__part {
    background: rgba(14, 16, 18, 0.45);
    backdrop-filter: blur(6px);
  }

  /* ---------- HELA RUTINEN: dark, every product on one shelf ---------- */
  .nr-kitx--system {
    --kitx-muted: rgba(255, 255, 255, 0.66);
    --kitx-line: rgba(255, 255, 255, 0.16);
    --kitx-save: var(--nr-save-on-dark);
    grid-template-rows: minmax(0, 1fr) auto;
    background:
      radial-gradient(90% 60% at 70% 100%, #2b2b2b 0%, #151515 60%);
    color: #fff;
  }

  .nr-kitx--system .nr-kitx__env {
    grid-row: 1;
    display: flex;
    align-items: center;
    padding: clamp(24px, 2.6vw, 40px) clamp(24px, 2.6vw, 40px) 0;
  }

  .nr-kitx--system .nr-kitx__body {
    grid-row: 2;
  }

  .nr-kitx--system .nr-kitx__name {
    font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem);
  }

  /* Two shelves of four on desktop, one row of eight on phones. */
  .nr-kitx__shelf {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
    gap: 14px 12px;
    width: 100%;
    padding: 22px 22px 0;
    background: linear-gradient(#efeeea, #e3e2dd);
    border-radius: 2px;
  }

  @media screen and (max-width: 989px) {
    .nr-kitx__shelf {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }

  .nr-kitx__shelf-item {
    display: block;
    aspect-ratio: 3 / 4;
  }

  .nr-kitx__shelf-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    mix-blend-mode: multiply;
  }

  .nr-kits__more {
    margin: var(--nr-space-md) 0 0;
  }

  /* ---------- Tablet & phones: one column, block order ---------- */
  @media screen and (max-width: 989px) {
    .nr-kits__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .nr-kits__cell--system {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .nr-kits .nr-section-head {
      margin-bottom: var(--nr-space-md);
    }

    .nr-kits__grid {
      gap: 12px;
      margin-inline: calc(var(--nr-space-sm) * -1);
    }

    .nr-kitx {
      border-radius: 0;
    }

    .nr-kitx__body {
      padding: 22px var(--nr-space-sm);
    }

    .nr-kitx--light .nr-kitx__env {
      width: 120px;
      height: 156px;
    }

    .nr-kitx--light .nr-kitx__body > :not(.nr-kitx__strip):not(.nr-kitx__actions) {
      max-width: calc(100% - 112px);
    }

    .nr-kitx--light .nr-kitx__actions {
      max-width: none;
    }

    .nr-kitx__packshot {
      inset: 20px 12px 0 0;
    }

    .nr-kitx--foam .nr-kitx__body {
      min-height: 300px;
      justify-content: flex-end;
    }

    .nr-kitx--foam .nr-kitx__env::after {
      background: linear-gradient(0deg, rgba(14, 16, 18, 0.88) 0%, rgba(14, 16, 18, 0.55) 60%, rgba(14, 16, 18, 0.25) 100%);
    }

    .nr-kitx--system .nr-kitx__env {
      padding: 24px var(--nr-space-sm) 0;
    }

    .nr-kitx__shelf {
      gap: 3px;
      padding: 12px 8px 0;
    }

    .nr-kitx__actions {
      width: 100%;
    }

    .nr-kitx__actions {
      flex-wrap: nowrap;
      gap: 16px;
      margin-top: 18px;
    }

    .nr-kitx__cta {
      flex: 1 1 auto;
    }

    .nr-kitx__price {
      margin-top: 16px;
    }

    .nr-kitx__name {
      font-size: 1.75rem;
    }

    .nr-kitx--system .nr-kitx__name {
      font-size: 2rem;
    }

    .nr-kits__more {
      padding-inline: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Hitta rätt paket",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Hitta rätt paket" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "more_label", "label": "Länktext under paketen", "info": "Pilen läggs till automatiskt.", "default": "Se alla färdiga paket" },
    { "type": "url", "id": "more_link", "label": "Länk" }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Paket",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Paketprodukt",
          "info": "Namn, pris, innehåll, styckpris och besparing räknas ut från produkten och dess innehåll (Paket – innehåll)."
        },
        { "type": "text", "id": "badge", "label": "Roll", "default": "Grunden", "info": "T.ex. Grunden, Foam setup, Hela rutinen." },
        { "type": "text", "id": "subheading", "label": "Passar dig som" },
        {
          "type": "select",
          "id": "style",
          "label": "Miljö",
          "options": [
            { "value": "light", "label": "Ljus (produktbild)" },
            { "value": "foam", "label": "Foam (video)" },
            { "value": "system", "label": "Mörk (alla produkter i rad)" }
          ],
          "default": "light"
        },
        { "type": "video", "id": "video", "label": "Video (Foam)", "info": "Kort, ljudlös loop. Spelas bara när den syns." },
        { "type": "image_picker", "id": "image", "label": "Bild (Ljus)", "info": "Tomt = paketets produktbild." },
        { "type": "text", "id": "button_label", "label": "Knapptext", "default": "Se kitet", "info": "Pilen läggs till automatiskt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR: Hitta rätt paket",
      "blocks": [
        { "type": "kit", "settings": { "badge": "Grunden", "style": "light" } },
        { "type": "kit", "settings": { "badge": "Foam setup", "style": "foam" } },
        { "type": "kit", "settings": { "badge": "Hela rutinen", "style": "system" } }
      ]
    }
  ]
}
{% endschema %}
