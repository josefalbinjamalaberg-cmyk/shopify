{% comment %}
  Discreet cross-sell section for a single hand-picked accessory product
  (e.g. Tryckspruta 2 L). Renders nothing when no product is selected in
  the theme editor, so the section never shows a placeholder to customers.
{% endcomment %}

{%- liquid
  assign product = section.settings.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
-%}

{%- if product != blank -%}
  <div
    class="section section--page-width alkastrike-cross-sell"
    style="{% render 'spacing-style', settings: section.settings %}{% if section.settings.background_color != blank %} background-color: {{ section.settings.background_color }};{% endif %}"
  >
    <div class="alkastrike-cross-sell__inner">
      <div class="alkastrike-cross-sell__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="alkastrike-cross-sell__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="alkastrike-cross-sell__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      {%- render 'alkastrike-product-tile', product: product, cta_text: 'Visa produkt' -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .alkastrike-cross-sell {
    padding-block: var(--padding-3xl, 56px);
  }

  .alkastrike-cross-sell__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--gap-2xl, 40px);
    padding: var(--padding-xl, 32px);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .alkastrike-cross-sell__heading {
    margin: 0 0 var(--margin-sm, 12px);
    font-size: var(--font-h4--size, 1.5rem);
  }

  .alkastrike-cross-sell__text {
    margin: 0;
    max-width: 46ch;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.75));
  }

  .alkastrike-cross-sell .alkastrike-tile {
    max-width: 220px;
  }

  @media screen and (max-width: 749px) {
    .alkastrike-cross-sell__inner {
      grid-template-columns: 1fr;
      padding: var(--padding-lg, 20px);
    }

    .alkastrike-cross-sell .alkastrike-tile {
      max-width: 160px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Alkastrike – tilläggsköp",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Komplettera med Tryckspruta 2 L"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Gör appliceringen jämnare och enklare med en tryckspruta anpassad för bilvårdskemikalier."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt",
      "info": "Sektionen döljs helt om ingen produkt är vald."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bakgrundsfärg",
      "placeholder": "Standard"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Topp",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Botten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Alkastrike – tilläggsköp"
    }
  ]
}
{% endschema %}
