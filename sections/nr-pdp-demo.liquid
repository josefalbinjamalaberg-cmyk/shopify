{%- doc -%}
  Standard PDP 03: the product in use — NordicReflection's own
  demonstration media (application, reaction, foam, rinse, result).

  Source: `pdp.demo_media` (list of files: videos and/or images), heading
  `pdp.demo_heading` (falls back to the section heading). The whole section
  is hidden when there is no media — never an empty placeholder.

  Optional `pdp.why` (multi-line text): a short "why does it work"
  explanation shown with the media — plain language, chemistry kept light.
  The section also renders with only `pdp.why` (no media), so the
  explanation is ready now and the media slot activates once real
  NordicReflection footage is added. No placeholders are ever shown.

  With two or more items the FIRST one is featured (larger on desktop), so
  put the strongest proof — e.g. the visible reaction — first in the list.

  Videos never autoplay and load no video data until the customer presses
  play (preload="none", poster image shown).
{%- enddoc -%}

{%- liquid
  assign media = product.metafields.pdp.demo_media.value
  assign why = product.metafields.pdp.why.value
  assign title_parts = product.title | replace: ' - ', ' – ' | split: ' – '
  assign name = title_parts.first | strip
  if media != blank
    assign heading = product.metafields.pdp.demo_heading.value | default: section.settings.heading
  else
    assign heading = section.settings.why_heading
  endif
  assign heading = heading | replace: '[produkt]', name
-%}

{%- if media != blank or why != blank -%}
  {{ 'nr-pdp.css' | asset_url | stylesheet_tag }}

  <section
    class="nr-pdp-section nr-pdp-demo"
    aria-labelledby="NrPdpDemoHeading"
  >
    <div class="nr-pdp-container">
      <header class="nr-pdp-section__head">
        <h2
          class="nr-pdp-section__heading"
          id="NrPdpDemoHeading"
        >
          {{ heading | escape }}
        </h2>
        {%- if why != blank -%}
          <div class="nr-pdp-demo__why">
            {%- assign why_lines = why | newline_to_br | split: '<br />' -%}
            {%- for why_line in why_lines -%}
              {%- assign why_text = why_line | strip -%}
              {%- if why_text != blank -%}
                <p>{{ why_text | escape }}</p>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if media != blank and section.settings.note != blank -%}
          <p class="nr-pdp-section__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </header>

      {%- if media != blank -%}
      <div
        class="nr-pdp-demo__grid"
        data-count="{{ media.size | at_most: 3 }}"
      >
        {%- for item in media limit: 3 -%}
          <figure class="nr-pdp-demo__item">
            {%- case item.media_type -%}
              {%- when 'video' -%}
                {{
                  item
                  | video_tag:
                    controls: true,
                    playsinline: true,
                    preload: 'none',
                    image_size: '1200x',
                    class: 'nr-pdp-demo__video'
                }}
              {%- when 'image' -%}
                {{
                  item
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 960, 1200, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    class: 'nr-pdp-demo__image'
                }}
            {%- endcase -%}
            {%- if item.alt != blank -%}
              <figcaption>{{ item.alt | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "NR PDP: Demo",
  "tag": "div",
  "class": "nr-pdp-shell",
  "settings": [
    {
      "type": "paragraph",
      "content": "Media väljs per produkt i metafältet pdp.demo_media (videor/bilder, max 3), förklaring i pdp.why. Rubrik från pdp.demo_heading. Sektionen döljs när produkten saknar både media och förklaring."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Standardrubrik",
      "info": "[produkt] ersätts med produktens namn.",
      "default": "Se [produkt] i praktiken"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Rubrik när produkten saknar media",
      "info": "[produkt] ersätts med produktens namn.",
      "default": "Så fungerar [produkt]"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Notering under rubriken",
      "default": "Filmat av NordicReflection."
    }
  ],
  "presets": [
    {
      "name": "NR PDP: Demo"
    }
  ]
}
{% endschema %}
