{%- doc -%}
  Kit PDP "Se resultatet": real product videos for the components of this
  kit — each component product's own custom.result_video. Nothing is shown
  for components without one, and the whole section hides when none have a
  video, so no media is ever invented. Videos load lazily (preload none,
  poster image) and never autoplay.
  Source per component: custom.result_video, else the first VIDEO in its
  standard-PDP demo media (pdp.demo_media) – both real NordicReflection clips.
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign components = kit.metafields.custom.kit_components.value
  assign video_count = 0
  for component in components
    assign component_video = component.variant.value.product.metafields.custom.result_video.value
    if component_video == blank
      assign demo_first = component.variant.value.product.metafields.pdp.demo_media.value | first
      if demo_first.media_type == 'video'
        assign component_video = demo_first
      endif
    endif
    if component_video != blank
      assign video_count = video_count | plus: 1
    endif
  endfor
-%}

{%- if video_count > 0 -%}
  <div class="nr-kit-section nr-kit-proof">
    <div class="nr-kit-container">
      <header class="nr-kit-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="nr-kit-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nr-kit-lead">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <ul
        class="nr-kit-proof__list"
        role="list"
      >
        {%- for component in components -%}
          {%- liquid
            assign component_product = component.variant.value.product
            assign component_video = component_product.metafields.custom.result_video.value
            if component_video == blank
              assign demo_first = component_product.metafields.pdp.demo_media.value | first
              if demo_first.media_type == 'video'
                assign component_video = demo_first
              else
                assign component_video = nil
              endif
            endif
            assign short_name = component_product.title | split: ' – ' | first | split: ' - ' | first
            assign role = component.role.value | default: component_product.metafields.custom.product_category.value
          -%}
          {%- if component_video != blank -%}
            <li class="nr-kit-proof__item">
              <div class="nr-kit-media nr-kit-proof__media">
                {{
                  component_video
                  | video_tag:
                    image_size: '720x',
                    controls: true,
                    muted: true,
                    loop: true,
                    playsinline: true,
                    preload: 'none'
                }}
              </div>
              <p class="nr-kit-proof__caption">
                <a href="{{ component_product.url }}">{{ short_name | escape }}</a>
                {%- if role != blank -%}
                  <span> · {{ role | escape }}</span>
                {%- endif -%}
              </p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR: Paket – se resultatet",
  "tag": "section",
  "class": "nr-kit-section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Visar komponenternas egna resultatvideor (produktens metafält Resultatvideo). Döljs om ingen komponent har en video."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Se resultatet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik",
      "default": "Produkterna i paketet, filmade i riktig användning."
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – se resultatet",
      "category": "Product"
    }
  ]
}
{% endschema %}
