{% comment %}
  "Vad kunder säger om NordicReflection": the page's dark proof moment.
  Rating, count and link: theme settings (NordicReflection – Trustpilot).
  Reviews: metaobject nr_trustpilot_review (verbatim Trustpilot reviews).
  Each card leads with a real phrase from the review (section setting
  "highlights", one per line). A review is only shown when its text
  contains the phrase word for word, so nothing can be misquoted; under it
  the sentence the phrase comes from (never cut mid-sentence), stars and
  the customer's name. Phones: one review per swipe, the next one peeking.
{% endcomment %}

{%- liquid
  assign rating = settings.nr_trustpilot_rating
  assign rating_count = settings.nr_trustpilot_count
  assign trustpilot_url = settings.nr_trustpilot_url
  assign reviews = shop.metaobjects.nr_trustpilot_review.values
  assign highlights = section.settings.highlights | newline_to_br | split: '<br />'
  assign shown_handles = '|'
  assign shown = 0
-%}

{%- capture cards -%}
  {%- for raw in highlights -%}
    {%- assign phrase = raw | strip -%}
    {%- if phrase == blank or shown >= section.settings.max_reviews -%}{%- continue -%}{%- endif -%}
    {%- for review in reviews -%}
      {%- liquid
        assign body = review.body.value
        assign key = '|' | append: review.system.handle | append: '|'
        unless body contains phrase
          continue
        endunless
        if shown_handles contains key
          continue
        endif
        assign shown_handles = shown_handles | append: key
        assign shown = shown | plus: 1

        # The sentence the phrase comes from (never cut mid-sentence); a very
        # short one gets its neighbour for context.
        assign norm = body | newline_to_br | replace: '<br />', '|' | strip_newlines | replace: '! ', '!|' | replace: '. ', '.|' | replace: '? ', '?|'
        assign sentences = norm | split: '|'
        assign idx = 0
        for sentence in sentences
          if sentence contains phrase
            assign idx = forloop.index0
            break
          endif
        endfor
        assign excerpt = sentences[idx] | strip
        if excerpt.size < 70
          if idx > 0
            assign prev = idx | minus: 1
            assign excerpt = sentences[prev] | strip | append: ' ' | append: excerpt
          elsif sentences.size > 1
            assign excerpt = excerpt | append: ' ' | append: sentences[1]
          endif
        endif
        assign review_rating = review.rating.value | default: 5
      -%}
      <li class="nr-proof__item">
        <figure class="nr-proof__review">
          <blockquote class="nr-proof__quote">
            <p class="nr-proof__phrase">”{{ phrase | capitalize | escape }}”</p>
            <p class="nr-proof__excerpt">{{ excerpt | strip | escape }}</p>
          </blockquote>
          <figcaption class="nr-proof__meta">
            <span class="nr-proof__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 12 12" focusable="false"{% if i > review_rating %} class="is-empty"{% endif %}><path d="M6 .8l1.55 3.3 3.6.42-2.66 2.47.7 3.56L6 8.77 2.81 10.55l.7-3.56L.85 4.52l3.6-.42z" fill="currentColor"/></svg>
              {%- endfor -%}
            </span>
            <span class="visually-hidden">{{ review_rating }} av 5 stjärnor.</span>
            {{ review.author.value | escape }}
          </figcaption>
        </figure>
      </li>
      {%- break -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <div data-nr-scope class="nr-section nr-section--dark nr-proof">
    <div class="nr-container">
      <div class="nr-section-head nr-proof__head" data-nr-reveal>
        <h2 class="nr-h2">{{ section.settings.heading | escape }}</h2>
        {%- if rating != blank -%}
          <p class="nr-proof__score">
            <span class="nr-proof__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 12 12" focusable="false"><path d="M6 .8l1.55 3.3 3.6.42-2.66 2.47.7 3.56L6 8.77 2.81 10.55l.7-3.56L.85 4.52l3.6-.42z" fill="currentColor"/></svg>
              {%- endfor -%}
            </span>
            <span>
              <strong>{{ rating | replace: '.', ',' | escape }}/5</strong> på Trustpilot
              {%- if rating_count > 0 %} · {{ rating_count }} omdömen{% endif -%}
            </span>
          </p>
        {%- endif -%}
      </div>

      <ul class="nr-proof__list" role="list" data-nr-reveal="stagger">
        {{ cards }}
      </ul>

      {%- if trustpilot_url != blank -%}
        <p class="nr-proof__foot">
          <a
            href="{{ trustpilot_url }}"
            class="nr-link"
            target="_blank"
            rel="noopener"
            data-nr-event="trustpilot_click"
            data-nr-source="home_reviews"
          >
            Läs alla omdömen på Trustpilot
            <span class="visually-hidden">(öppnas i ny flik)</span>
            <span class="nr-link__arrow" aria-hidden="true">↗</span>
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* The page's dark proof moment: a few real phrases, large; the sentence
     they come from; the customer. */
  .nr-proof__head {
    max-width: var(--nr-text-width);
  }

  .nr-proof__score {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 12px 0 0;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .nr-proof__score strong {
    color: #fff;
  }

  .nr-proof__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--nr-save-on-dark);
  }

  .nr-proof__stars svg {
    width: 14px;
    height: 14px;
  }

  .nr-proof__stars svg.is-empty {
    color: rgba(255, 255, 255, 0.24);
  }

  .nr-proof__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--nr-space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nr-proof__item {
    position: relative;
    min-width: 0;
    padding-top: var(--nr-space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.24);
  }

  .nr-proof__review,
  .nr-proof__quote {
    margin: 0;
  }

  .nr-proof__phrase {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.125rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .nr-proof__excerpt {
    margin: 14px 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }

  .nr-proof__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .nr-proof__foot {
    margin: var(--nr-space-lg) 0 0;
  }

  .nr-proof .nr-link {
    color: #fff;
  }

  /* Phones: one review per swipe, the next one peeking. */
  @media screen and (max-width: 749px) {
    .nr-proof__list {
      display: flex;
      gap: var(--nr-space-md);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--nr-space-sm);
      margin-inline: calc(var(--nr-space-sm) * -1);
      padding-inline: var(--nr-space-sm);
      scrollbar-width: none;
    }

    .nr-proof__list::-webkit-scrollbar {
      display: none;
    }

    .nr-proof__item {
      flex: 0 0 84%;
      padding-top: var(--nr-space-sm);
      scroll-snap-align: start;
    }

    .nr-proof__phrase {
      font-size: 1.625rem;
    }

    .nr-proof__excerpt {
      margin-top: 10px;
      font-size: 0.875rem;
    }

    .nr-proof__foot {
      margin-top: var(--nr-space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Kundomdömen",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Betyg och länk: Temainställningar → NordicReflection – Trustpilot. Omdömen: metaobjektet Trustpilot-omdöme."
    },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vad kunder säger om NordicReflection" },
    {
      "type": "textarea",
      "id": "highlights",
      "label": "Fraser att lyfta (en per rad)",
      "info": "Exakta ord ur omdömena. Ett omdöme visas bara om frasen finns ordagrant i texten, så inget kan bli fel citerat."
    },
    { "type": "range", "id": "max_reviews", "label": "Antal omdömen", "min": 1, "max": 3, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "NR: Kundomdömen" }]
}
{% endschema %}
