{%- doc -%}
  Kit PDP tier comparison ("Jämför paketen"), for families of kits that are
  sizes of the same thing (e.g. the interior kits).

  Everything is computed from data: the columns are the kits in
  custom.kit_family, the rows are every component variant that appears in
  any of them (in order of first appearance), and each cell shows whether
  that kit contains it. The last row is each kit's saving versus buying its
  own components separately. The current kit's column is highlighted.

  Above the table, each kit's own custom.kit_card_line explains why that
  tier exists and links to it.
{%- enddoc -%}

{%- liquid
  assign kit = product
  assign family = kit.metafields.custom.kit_family.value

  # Every component variant id across the family, first appearance first.
  assign variant_ids = ''
  for family_kit in family limit: 3
    for component in family_kit.metafields.custom.kit_components.value
      assign component_variant = component.variant.value
      if component_variant != blank
        assign id_string = component_variant.id | append: ''
        assign haystack = '§' | append: variant_ids | append: '§'
        assign needle = '§' | append: id_string | append: '§'
        unless haystack contains needle
          if variant_ids == blank
            assign variant_ids = id_string
          else
            assign variant_ids = variant_ids | append: '§' | append: id_string
          endif
        endunless
      endif
    endfor
  endfor
  assign row_ids = variant_ids | split: '§'
-%}

{%- if family.size > 1 and row_ids.size > 0 -%}
  <div class="nr-kit-section nr-kit-tiers">
    <div class="nr-kit-container">
      <header class="nr-kit-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="nr-kit-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nr-kit-lead">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <ul
        class="nr-kit-tiers__summary"
        role="list"
      >
        {%- for family_kit in family limit: 3 -%}
          {%- assign family_line = family_kit.metafields.custom.kit_card_line.value -%}
          <li class="nr-kit-tiers__summary-item{% if family_kit.id == kit.id %} is-current{% endif %}">
            {%- if family_kit.id == kit.id -%}
              <span class="nr-kit-tiers__summary-title">{{ family_kit.title | escape }}</span>
              <span class="nr-kit-family__current">{{ section.settings.current_label | escape }}</span>
            {%- else -%}
              <a
                href="{{ family_kit.url }}"
                class="nr-kit-tiers__summary-title"
              >
                {{- family_kit.title | escape -}}
              </a>
            {%- endif -%}
            {%- if family_line != blank -%}
              <span class="nr-kit-tiers__summary-line">{{ family_line | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="nr-kit-tiers__scroll">
        <table class="nr-kit-tiers__table">
          <caption class="visually-hidden">{{ section.settings.heading | escape }}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Innehåll</span></th>
              {%- for family_kit in family limit: 3 -%}
                {%- liquid
                  assign short_title = family_kit.metafields.custom.kit_eyebrow.value | split: ' · ' | last
                  if short_title == blank
                    assign short_title = family_kit.title
                  endif
                -%}
                <th
                  scope="col"
                  {% if family_kit.id == kit.id %}
                    class="is-current" aria-current="true"
                  {% endif %}
                >
                  <span class="nr-kit-tiers__col-title">{{ short_title | escape }}</span>
                  <span class="nr-kit-tiers__col-price">{{ family_kit.price | money }}</span>
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row_id in row_ids -%}
              {%- liquid
                assign row_name = ''
                assign row_size = ''
                for family_kit in family limit: 3
                  for component in family_kit.metafields.custom.kit_components.value
                    assign component_variant = component.variant.value
                    assign component_id = component_variant.id | append: ''
                    if row_name == blank and component_id == row_id
                      assign row_name = component_variant.product.title | split: ' – ' | first | split: ' - ' | first
                      assign row_size = component.size.value
                    endif
                  endfor
                endfor
              -%}
              <tr>
                <th scope="row">
                  {{ row_name | escape }}
                  {%- if row_size != blank -%}
                    <span class="nr-kit-tiers__size">{{ row_size | escape }}</span>
                  {%- endif -%}
                </th>
                {%- for family_kit in family limit: 3 -%}
                  {%- liquid
                    assign included = false
                    for component in family_kit.metafields.custom.kit_components.value
                      assign component_id = component.variant.value.id | append: ''
                      if component_id == row_id
                        assign included = true
                      endif
                    endfor
                  -%}
                  <td{% if family_kit.id == kit.id %} class="is-current"{% endif %}>
                    {%- if included -%}
                      {%- render 'nr-kit-check' -%}
                      <span class="visually-hidden">Ingår</span>
                    {%- else -%}
                      <span
                        class="nr-kit-tiers__none"
                        aria-hidden="true"
                      >
                        –
                      </span>
                      <span class="visually-hidden">Ingår inte</span>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
            <tr class="nr-kit-tiers__saving">
              <th scope="row">{{ section.settings.saving_label | escape }}</th>
              {%- for family_kit in family limit: 3 -%}
                {%- liquid
                  capture family_separate
                    render 'nr-kit-separate-total', product: family_kit
                  endcapture
                  assign family_separate = family_separate | strip | plus: 0
                  assign family_saving = 0
                  if family_separate > family_kit.price
                    assign family_saving = family_separate | minus: family_kit.price
                  endif
                -%}
                <td{% if family_kit.id == kit.id %} class="is-current"{% endif %}>
                  {%- if family_saving > 0 -%}
                    {{ family_saving | money }}
                  {%- else -%}
                    –
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR: Paket – jämför nivåer",
  "tag": "section",
  "class": "nr-kit-section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "Tabellen räknas fram från paketfamiljens komponenter. Besparingen jämförs med att köpa respektive pakets produkter separat."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Jämför paketen"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underrubrik",
      "default": "Samma grund – olika mycket. Välj efter hur mycket av kupén du vill kunna rengöra."
    },
    {
      "type": "text",
      "id": "current_label",
      "label": "Etikett för aktuellt paket",
      "default": "Ditt val"
    },
    {
      "type": "text",
      "id": "saving_label",
      "label": "Etikett för besparing",
      "default": "Du sparar"
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – jämför nivåer",
      "category": "Product"
    }
  ]
}
{% endschema %}
