{%- doc -%}
  Standard PDP 06: "I tvättrutinen" — where the product sits in the wash
  routine. One routine for every product page, defined once in this
  section's settings: up to 4 stages, each with a title and a product list.
  The stage that contains the current product is highlighted; the section
  is hidden on products that aren't in any stage (towels, tools…).

  Problem map (section blocks "Problem → produkt"): for products that
  customers confuse with each other (Revolt / Alkastrike / DeepDegrease), a
  simple "which problem → which product" list is shown instead of the stage
  strip whenever the current product is one of the mapped products.

  Products are product references, so names and links always come from the
  product itself. An optional per-product note comes from `pdp.routine_note`
  (e.g. that a speciality product is only needed when required).
{%- enddoc -%}

{%- liquid
  assign current_stage = 0
  for i in (1..4)
    case i
      when 1
        assign stage_products = section.settings.stage_1_products
      when 2
        assign stage_products = section.settings.stage_2_products
      when 3
        assign stage_products = section.settings.stage_3_products
      when 4
        assign stage_products = section.settings.stage_4_products
    endcase
    for stage_product in stage_products
      if stage_product.id == product.id
        assign current_stage = i
      endif
    endfor
  endfor

  assign routine_note = product.metafields.pdp.routine_note.value

  assign in_map = false
  for block in section.blocks
    if block.settings.product.id == product.id
      assign in_map = true
    endif
  endfor

  assign title_parts = product.title | replace: ' - ', ' – ' | split: ' – '
  assign name = title_parts.first | strip
  assign heading = section.settings.heading | replace: '[produkt]', name
-%}

{%- if current_stage > 0 or in_map -%}
  {{ 'nr-pdp.css' | asset_url | stylesheet_tag }}

  <section
    class="nr-pdp-section nr-pdp-routine"
    aria-labelledby="NrPdpRoutineHeading"
  >
    <div class="nr-pdp-container">
      <header class="nr-pdp-section__head">
        <h2
          class="nr-pdp-section__heading"
          id="NrPdpRoutineHeading"
        >
          {{ heading | escape }}
        </h2>
        {%- if routine_note != blank -%}
          <p class="nr-pdp-section__note">{{ routine_note | escape }}</p>
        {%- endif -%}
      </header>

      {%- if in_map -%}
        <ul
          class="nr-pdp-map"
          role="list"
        >
          {%- for block in section.blocks -%}
            {%- assign map_product = block.settings.product -%}
            {%- if map_product == blank or block.settings.problem == blank -%}{%- continue -%}{%- endif -%}
            {%- assign map_name = map_product.title | replace: ' - ', ' – ' | split: ' – ' | first | strip -%}
            <li
              class="nr-pdp-map__row{% if map_product.id == product.id %} is-current{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="nr-pdp-map__problem">{{ block.settings.problem | escape }}</span>
              <span
                class="nr-pdp-map__arrow"
                aria-hidden="true"
              >
                &rarr;
              </span>
              {%- if map_product.id == product.id -%}
                <span class="nr-pdp-map__product">
                  {{- map_name | escape -}}
                  <span class="nr-pdp-map__here">Den här produkten</span>
                </span>
              {%- else -%}
                <a
                  class="nr-pdp-map__product"
                  href="{{ map_product.url }}"
                  data-nr-event="cross_sell_click"
                  data-nr-product="{{ map_product.handle }}"
                  data-nr-source="routine_map"
                >
                  {{- map_name | escape -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
      <ol
        class="nr-pdp-routine__stages"
        role="list"
      >
        {%- for i in (1..4) -%}
          {%- liquid
            case i
              when 1
                assign stage_title = section.settings.stage_1_title
                assign stage_products = section.settings.stage_1_products
              when 2
                assign stage_title = section.settings.stage_2_title
                assign stage_products = section.settings.stage_2_products
              when 3
                assign stage_title = section.settings.stage_3_title
                assign stage_products = section.settings.stage_3_products
              when 4
                assign stage_title = section.settings.stage_4_title
                assign stage_products = section.settings.stage_4_products
            endcase
          -%}
          {%- if stage_title != blank -%}
            <li
              class="nr-pdp-routine__stage{% if i == current_stage %} is-current{% endif %}"
              {% if i == current_stage %}
                aria-current="step"
              {% endif %}
            >
              <span class="nr-pdp-routine__title">
                {%- if i == current_stage -%}
                  <span class="visually-hidden">Här: </span>
                {%- endif -%}
                {{- stage_title | escape -}}
              </span>
              {%- if stage_products != blank -%}
                <span class="nr-pdp-routine__products">
                  {%- for stage_product in stage_products -%}
                    {%- assign stage_name = stage_product.title | replace: ' - ', ' – ' | split: ' – ' | first | strip -%}
                    {%- if stage_product.id == product.id -%}
                      <strong>{{ stage_name | escape }}</strong>
                    {%- else -%}
                      <a
                        href="{{ stage_product.url }}"
                        data-nr-event="cross_sell_click"
                        data-nr-product="{{ stage_product.handle }}"
                        data-nr-source="routine"
                      >
                        {{- stage_name | escape -}}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      {%- endif -%}

      {%- if section.settings.footer != blank and in_map == false -%}
        <p class="nr-pdp-routine__footer">{{ section.settings.footer | escape }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "NR PDP: I tvättrutinen",
  "tag": "div",
  "class": "nr-pdp-shell",
  "settings": [
    {
      "type": "paragraph",
      "content": "Samma rutin på alla produktsidor. Steget som innehåller produkten markeras; sektionen döljs på produkter som inte finns i något steg."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "info": "[produkt] ersätts med produktens namn.",
      "default": "Var passar [produkt] in?"
    },
    {
      "type": "text",
      "id": "stage_1_title",
      "label": "Steg 1 – rubrik"
    },
    {
      "type": "product_list",
      "id": "stage_1_products",
      "label": "Steg 1 – produkter",
      "limit": 4
    },
    {
      "type": "text",
      "id": "stage_2_title",
      "label": "Steg 2 – rubrik"
    },
    {
      "type": "product_list",
      "id": "stage_2_products",
      "label": "Steg 2 – produkter",
      "limit": 4
    },
    {
      "type": "text",
      "id": "stage_3_title",
      "label": "Steg 3 – rubrik"
    },
    {
      "type": "product_list",
      "id": "stage_3_products",
      "label": "Steg 3 – produkter",
      "limit": 4
    },
    {
      "type": "text",
      "id": "stage_4_title",
      "label": "Steg 4 – rubrik"
    },
    {
      "type": "product_list",
      "id": "stage_4_products",
      "label": "Steg 4 – produkter",
      "limit": 4
    },
    {
      "type": "text",
      "id": "footer",
      "label": "Text under rutinen",
      "default": "Du behöver inte alla steg vid varje tvätt – välj det bilen behöver."
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem → produkt",
      "settings": [
        {
          "type": "text",
          "id": "problem",
          "label": "Problem",
          "info": "T.ex. \"Flygrost & bromsdamm\"."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produkt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR PDP: I tvättrutinen"
    }
  ]
}
{% endschema %}
