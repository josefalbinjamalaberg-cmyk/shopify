{% comment %}
  "Utvalda kategorier" — four fixed, equal-width category cards directly
  under the hero. Each card always renders (label + link have schema
  defaults), so a missing image can never collapse the grid down to a
  single card the way the previous collection-picker version could.
  Image object-position reads each image's native Shopify focal point
  (set in Admin → Media), so no per-card position setting is needed.
{% endcomment %}

<div data-nr-scope class="nr-section nr-categories">
  <div class="nr-container">
    <h2 class="nr-h2 nr-categories__heading">{{ section.settings.heading }}</h2>

    <ul
      class="nr-categories__grid{% if section.blocks.size == 3 %} nr-categories__grid--feature{% endif %}"
      role="list"
      style="--nr-categories-count: {{ section.blocks.size }};"
      data-nr-reveal="stagger"
    >
      {% for block in section.blocks %}
        {%- liquid
          assign image = block.settings.image
          assign focal_point = image.presentation.focal_point | default: 'center'
        -%}
        <li class="nr-categories__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="nr-categories__card">
            <span class="nr-categories__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.label,
                    widths: '400, 600, 900',
                    sizes: '(min-width: 990px) 50vw, (min-width: 750px) 46vw, 92vw',
                    style: 'object-position: ' | append: focal_point
                }}
              {%- else -%}
                <span class="nr-placeholder nr-categories__placeholder">
                  <span class="nr-placeholder__label">Bild kommer snart</span>
                </span>
              {%- endif -%}
            </span>
            <span class="nr-categories__label">{{ block.settings.label }}</span>
            {%- if block.settings.description != blank -%}
              <span class="nr-categories__description">{{ block.settings.description }}</span>
            {%- endif -%}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  /* Extra bottom air on this section specifically — on top of the shared
     .nr-section padding-block, not instead of it, so other homepage
     sections using .nr-section stay untouched. */
  .nr-categories {
    padding-bottom: calc(var(--nr-section-space) + 24px);
  }

  .nr-categories__heading {
    text-align: left;
    /* Base heading→grid gap (var(--nr-space-lg)) plus a bit more
       breathing room, scoped to this heading only — doesn't touch the
       shared --nr-space-lg variable or any other section's spacing. */
    margin-bottom: calc(var(--nr-space-lg) + 24px);
    /* ~12.5% smaller than the shared .nr-h2 scale at every breakpoint, so
       this heading doesn't visually compete with the more commercially
       important problem-solving sections above/below it. */
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.625rem);
  }

  .nr-categories__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Column count matches the actual number of blocks (set via inline
       custom property above), so removing a card re-spaces the rest
       evenly across the full row instead of leaving a phantom column. */
    grid-template-columns: repeat(var(--nr-categories-count, 4), minmax(0, 1fr));
    gap: var(--nr-space-md);
  }

  .nr-categories__card {
    display: flex;
    flex-direction: column;
    gap: var(--nr-space-sm);
    text-decoration: none;
    color: inherit;
  }

  .nr-categories__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--nr-radius-md);
    background: var(--nr-bg-soft);
  }

  .nr-categories__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
  }

  .nr-categories__placeholder {
    min-height: 0;
    border-radius: var(--nr-radius-md);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .nr-categories__card:hover .nr-categories__media img {
      transform: scale(1.04);
    }
  }

  .nr-categories__card:focus-visible {
    outline: 2px solid var(--nr-text);
    outline-offset: 4px;
    border-radius: var(--nr-radius-md);
  }

  .nr-categories__label {
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nr-categories__description {
    margin-top: -8px;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--nr-text-muted);
  }

  .nr-categories__card:active .nr-categories__media {
    transform: scale(0.99);
  }

  .nr-categories__media {
    transition: transform var(--nr-transition-fast);
  }

  /* Three categories: one large feature tile beside two stacked tiles,
     instead of a third row of identical equal-width cards on the page. */
  @media screen and (min-width: 990px) {
    .nr-categories__grid--feature {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: var(--nr-space-lg);
      row-gap: var(--nr-space-md);
    }

    .nr-categories__grid--feature > :first-child {
      grid-row: span 2;
    }

    .nr-categories__grid--feature .nr-categories__card {
      height: 100%;
    }

    .nr-categories__grid--feature > :first-child .nr-categories__media {
      aspect-ratio: auto;
      flex: 1;
      min-height: 0;
    }

    .nr-categories__grid--feature > :not(:first-child) .nr-categories__media {
      aspect-ratio: 16 / 9;
    }

    .nr-categories__grid--feature > :first-child .nr-categories__label {
      font-size: 1.375rem;
    }
  }

  @media screen and (max-width: 989px) {
    .nr-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nr-categories__grid--feature > :first-child {
      grid-column: 1 / -1;
    }

    .nr-categories__grid--feature > :first-child .nr-categories__media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Mobile: the first category full width, the other two side by side.
     Shorter than three stacked full-width photos, still no carousel. */
  @media screen and (max-width: 749px) {
    .nr-categories__heading {
      margin-bottom: var(--nr-space-md);
      font-size: clamp(1.375rem, 1.2rem + 1vw, 1.75rem);
    }

    .nr-categories__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .nr-categories__grid--feature {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 12px;
    }

    .nr-categories__card {
      gap: 10px;
    }

    .nr-categories__media {
      aspect-ratio: 4 / 3;
    }

    .nr-categories__grid--feature > :first-child .nr-categories__media {
      aspect-ratio: 4 / 3;
    }

    .nr-categories__grid--feature > :not(:first-child) .nr-categories__media {
      aspect-ratio: 1;
    }

    .nr-categories__grid--feature > :not(:first-child) .nr-categories__label {
      font-size: 1rem;
    }

    .nr-categories__grid--feature > :not(:first-child) .nr-categories__description {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Utvalda kategorier",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Utvalda kategorier"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Namn",
          "default": "Kategori"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Kort beskrivning (valfri)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Länk (kollektion, sida eller produkt)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild",
          "info": "Bildbeskärningen följer bildens fokuspunkt (Admin → Innehåll → Filer)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR: Utvalda kategorier",
      "blocks": [
        { "type": "category", "settings": { "label": "Exteriör" } },
        { "type": "category", "settings": { "label": "Interiör" } },
        { "type": "category", "settings": { "label": "Tillbehör" } },
        { "type": "category", "settings": { "label": "Färdiga paket" } }
      ]
    }
  ]
}
{% endschema %}
