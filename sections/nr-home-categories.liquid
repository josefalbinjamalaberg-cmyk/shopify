{% comment %}
  Category portals: three ways into the brand, not three collection cards.
  Three blocks: one dominant portal beside two stacked ones (desktop); on
  phones the first full width, the other two side by side. Real photos full
  bleed with the name, one line and "Utforska" on a bottom scrim. Image
  crop follows each image's Shopify focal point. HEIC originals are served
  as progressive JPEG so every browser can show them.
{% endcomment %}

<div data-nr-scope class="nr-section nr-categories">
  <div class="nr-container">
    <h2 class="nr-h2 nr-categories__heading">{{ section.settings.heading | escape }}</h2>

    <ul
      class="nr-portals nr-portals--{{ section.blocks.size }}"
      role="list"
      data-nr-reveal="stagger"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign focal_point = image.presentation.focal_point | default: 'center'
          assign image_src = image.src | downcase
          assign is_lead = false
          if forloop.first and section.blocks.size == 3
            assign is_lead = true
          endif
        -%}
        <li class="nr-portals__item{% if is_lead %} nr-portals__item--lead{% endif %}" {{ block.shopify_attributes }}>
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="nr-portal"
            data-nr-event="category_portal_click"
            data-nr-source="{{ block.settings.label | handleize }}"
          >
            <span class="nr-portal__media">
              {%- if image != blank -%}
                {%- comment -%} HEIC originals are served as progressive JPEG so every browser shows them. {%- endcomment -%}
                {%- if image_src contains '.heic' -%}
                  {{
                    image
                    | image_url: width: 1400, format: 'pjpg'
                    | image_tag:
                      loading: 'lazy',
                      alt: '',
                      widths: '480, 720, 960, 1400',
                      sizes: '(min-width: 990px) 60vw, 100vw',
                      style: 'object-position: ' | append: focal_point
                  }}
                {%- else -%}
                  {{
                    image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      alt: '',
                      widths: '480, 720, 960, 1400',
                      sizes: '(min-width: 990px) 60vw, 100vw',
                      style: 'object-position: ' | append: focal_point
                  }}
                {%- endif -%}
              {%- endif -%}
            </span>
            <span class="nr-portal__text">
              <span class="nr-portal__label">{{ block.settings.label | escape }}</span>
              {%- if block.settings.description != blank -%}
                <span class="nr-portal__line">{{ block.settings.description | escape }}</span>
              {%- endif -%}
              <span class="nr-portal__cta">{{ section.settings.cta_label | default: 'Utforska' | escape }} <span aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .nr-categories__heading {
    margin-bottom: var(--nr-space-lg);
  }

  /* Portals: one dominant category beside two stacked ones. Real photos
     full bleed, text on a bottom scrim, no card chrome. */
  .nr-portals {
    display: grid;
    grid-template-columns: repeat(var(--nr-portal-cols, 3), minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nr-portals--3 {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: repeat(2, clamp(240px, 22vw, 330px));
  }

  .nr-portals--3 .nr-portals__item--lead {
    grid-row: 1 / span 2;
  }

  .nr-portals--2 {
    --nr-portal-cols: 2;
  }

  .nr-portals--4 {
    --nr-portal-cols: 4;
  }

  .nr-portals__item {
    display: flex;
    min-width: 0;
    min-height: 260px;
  }

  .nr-portal {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    overflow: hidden;
    border-radius: var(--nr-radius-sm);
    background: #1b1b1b;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .nr-portal__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .nr-portal__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--nr-ease-out);
  }

  .nr-portal__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 10, 10, 0.72) 0%, rgba(10, 10, 10, 0.25) 45%, rgba(10, 10, 10, 0) 70%);
  }

  .nr-portal__text {
    display: grid;
    gap: 6px;
    padding: clamp(20px, 2.4vw, 36px);
  }

  .nr-portal__label {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .nr-portals__item--lead .nr-portal__label {
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 4rem);
  }

  .nr-portal__line {
    max-width: 32ch;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.86);
  }

  .nr-portal__cta {
    margin-top: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nr-portal__cta span {
    display: inline-block;
    transition: transform var(--nr-transition-fast);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .nr-portal:hover .nr-portal__media img {
      transform: scale(1.035);
    }

    .nr-portal:hover .nr-portal__cta span {
      transform: translateX(4px);
    }
  }

  .nr-portal:focus-visible {
    outline: 2px solid var(--nr-text);
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .nr-portals--3 {
      grid-template-rows: repeat(2, 260px);
    }

    .nr-portals--4 {
      --nr-portal-cols: 2;
    }
  }

  /* Phones: the lead portal full width, the other two side by side. */
  @media screen and (max-width: 749px) {
    .nr-categories__heading {
      margin-bottom: var(--nr-space-md);
    }

    .nr-portals,
    .nr-portals--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: 8px;
    }

    .nr-portals__item {
      min-height: 0;
      aspect-ratio: 1;
    }

    .nr-portals--3 .nr-portals__item--lead {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 16 / 10;
    }

    .nr-portal__text {
      padding: 16px;
    }

    .nr-portals__item:not(.nr-portals__item--lead) .nr-portal__line {
      display: none;
    }

    .nr-portals__item--lead .nr-portal__label {
      font-size: 2rem;
    }

    .nr-portal__label {
      font-size: 1.375rem;
    }

    .nr-portal__cta {
      margin-top: 4px;
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NR: Utvalda kategorier",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Utvalda kategorier"
    },
    { "type": "text", "id": "cta_label", "label": "Länktext", "default": "Utforska", "info": "Pilen läggs till automatiskt." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Namn",
          "default": "Kategori"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Kort beskrivning (valfri)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Länk (kollektion, sida eller produkt)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild",
          "info": "Bildbeskärningen följer bildens fokuspunkt (Admin → Innehåll → Filer)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NR: Utvalda kategorier",
      "blocks": [
        { "type": "category", "settings": { "label": "Exteriör" } },
        { "type": "category", "settings": { "label": "Interiör" } },
        { "type": "category", "settings": { "label": "Tillbehör" } },
        { "type": "category", "settings": { "label": "Färdiga paket" } }
      ]
    }
  ]
}
{% endschema %}
