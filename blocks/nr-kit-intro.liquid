{%- doc -%}
  Kit PDP: eyebrow, title, one-line value proposition and store rating at the
  top of the purchase column. Eyebrow and value line come from the kit's own
  metafields (custom.kit_eyebrow, custom.kit_tagline) and hide when empty.

  The rating is the store's Trustpilot rating (theme settings → NordicReflection
  – Trustpilot), labelled "NordicReflection …" – never a kit-specific rating.

  Also loads assets/nr-kit.css, the shared stylesheet for every kit section,
  so the kit styles only ship on kit pages.
{%- enddoc -%}

{{ 'nr-kit.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign kit = closest.product
  assign eyebrow = kit.metafields.custom.kit_eyebrow.value
  assign tagline = kit.metafields.custom.kit_tagline.value
  assign rating = settings.nr_trustpilot_rating
  if rating == blank
    assign rating = block.settings.rating_text | split: '/' | first
  endif
-%}

<div
  class="nr-kit-intro"
  {{ block.shopify_attributes }}
>
  {%- comment -%}
    Brand-level proof first (mobile: directly under the gallery). It is the
    store's Trustpilot rating – never presented as a rating of this kit.
  {%- endcomment -%}
  {%- if rating != blank -%}
    <a
      class="nr-kit-intro__rating"
      href="#NrPdpTrust"
      data-nr-event="trustpilot_click"
      data-nr-source="kit_hero"
    >
      <span>NordicReflection</span>
      <span
        class="nr-kit-stars"
        aria-hidden="true"
      >
        {%- for i in (1..5) -%}
          <svg
            viewBox="0 0 12 12"
            focusable="false"
          >
            <path d="M6 .8l1.55 3.3 3.6.42-2.66 2.47.7 3.56L6 8.77 2.81 10.55l.7-3.56L.85 4.52l3.6-.42z" fill="currentColor"/>
          </svg>
        {%- endfor -%}
      </span>
      <span>{{ rating | replace: '.', ',' | escape }}/5 på Trustpilot</span>
    </a>
  {%- endif -%}

  {%- if eyebrow != blank -%}
    <p class="nr-kit-eyebrow">{{ eyebrow | escape }}</p>
  {%- endif -%}

  <h1 class="nr-kit-intro__title">{{ kit.title | escape }}</h1>

  {%- if tagline != blank -%}
    <p class="nr-kit-intro__tagline">{{ tagline | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NR: Paket – introduktion",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Överrubrik och värdemening hämtas från paketets metafält (Paket – överrubrik, Paket – värdemening)."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Betyg",
      "info": "Används bara om temainställningen NordicReflection – Trustpilot saknar betyg.",
      "default": "4.7/5 på Trustpilot"
    },
    {
      "type": "text",
      "id": "rating_link_label",
      "label": "Länktext",
      "default": "Läs omdömen"
    },
    {
      "type": "url",
      "id": "rating_url",
      "label": "Länk till omdömen"
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – introduktion",
      "category": "Product"
    }
  ]
}
{% endschema %}
