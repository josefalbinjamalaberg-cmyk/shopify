{%- doc -%}
  Kit PDP: one compact delivery/trust line under the buy button, plus the
  payment methods the shop actually has enabled (shop.enabled_payment_types),
  kept small so they never compete with the CTA.
{%- enddoc -%}

<div
  class="nr-kit-trust"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.text != blank -%}
    <p class="nr-kit-trust__text">{{ block.settings.text | escape }}</p>
  {%- endif -%}

  {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
    <ul
      class="nr-kit-trust__payments"
      role="list"
    >
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'nr-kit-trust__payment-icon' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NR: Paket – leverans",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Använd bara aktuella, korrekta leveransvillkor.",
      "default": "Leverans inom 1–3 arbetsdagar · Säker betalning"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Visa betalsätt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "NR: Paket – leverans",
      "category": "Product"
    }
  ]
}
{% endschema %}
