{%- doc -%}
  Kit page (v3): the quiet lines directly under the buy buttons.
    1. Delivery + free-shipping threshold from the global theme settings
       (Frakt & leverans) – never typed per kit.
    2. The store's Trustpilot rating from theme settings (NordicReflection –
       Trustpilot), explicitly labelled as reviews of NordicReflection, not
       of this kit.
{%- enddoc -%}

{%- liquid
  assign kit = closest.product
  assign threshold = settings.free_shipping_threshold
  assign delivery_text = settings.delivery_time_text
  assign shipping_text = ''
  if threshold > 0
    assign threshold_cents = threshold | times: 100
    if kit.price >= threshold_cents
      assign shipping_text = 'Fri frakt på kitet'
    else
      assign shipping_text = 'Fri frakt över ' | append: threshold | append: '&nbsp;kr'
    endif
  endif
  assign rating = settings.nr_trustpilot_rating
  assign rating_url = settings.nr_trustpilot_url
-%}

<div
  class="nr-kp-meta"
  {{ block.shopify_attributes }}
>
  {%- if delivery_text != blank or shipping_text != blank -%}
    <p class="nr-kp-meta__delivery">
      {{- delivery_text | escape -}}
      {%- if delivery_text != blank and shipping_text != blank %} · {% endif -%}
      {{- shipping_text -}}
    </p>
  {%- endif -%}

  {%- comment -%}
    Brand rating (never a product rating). The figure comes only from the
    existing theme setting NordicReflection – Trustpilot, and is shown only when
    the block setting "rating_verified" confirms it is current. Otherwise a plain
    link to the real Trustpilot profile.
  {%- endcomment -%}
  {%- if rating_url != blank -%}
    <p class="nr-kp-meta__rating">
      <a
        href="{{ rating_url }}"
        target="_blank"
        rel="noopener"
        data-nr-event="trustpilot_click"
        data-nr-source="kit_buybox"
      >
        {%- if rating != blank and block.settings.rating_verified -%}
          NordicReflection på Trustpilot · {{ rating | replace: '.', ',' | escape }}/5 · <span class="nr-kp-meta__cta">Läs omdömen</span>
        {%- else -%}
          Läs omdömen om NordicReflection på Trustpilot
        {%- endif -%}
        <span class="visually-hidden"> (öppnas i ny flik)</span>
      </a>
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NR Kit: leverans",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Leverans och fri frakt hämtas från temainställningen Frakt & leverans. Länk och betyg från temainställningen NordicReflection – Trustpilot."
    },
    {
      "type": "checkbox",
      "id": "rating_verified",
      "label": "Visa betyget (bekräftat)",
      "info": "Kryssa i först när betyget i temainställningen NordicReflection – Trustpilot är kontrollerat mot Trustpilot. Annars visas bara en länk.",
      "default": false
    }
  ],
  "presets": [{ "name": "NR Kit: leverans", "category": "Product" }]
}
{% endschema %}
