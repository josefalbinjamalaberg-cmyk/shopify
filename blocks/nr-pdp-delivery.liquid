{%- doc -%}
  Standard PDP: compact delivery / payment line under the buy button.

  Every value comes from the global theme settings (Frakt & leverans), so
  the free-shipping threshold and delivery time are defined in ONE place:
  - settings.free_shipping_threshold (kr)
  - settings.delivery_time_text
  "Inkl. moms" is shown when the store's prices include tax (replaces the
  price block's generic tax/shipping note, so there is one shipping message).
  Payment methods come from the store's enabled payment types (small icons,
  max 5 — no logo wall).
{%- enddoc -%}

{%- liquid
  assign threshold = settings.free_shipping_threshold
  assign delivery_text = settings.delivery_time_text
-%}

<div
  class="nr-pdp-delivery"
  {{ block.shopify_attributes }}
>
  {%- if delivery_text != blank or threshold > 0 -%}
    <p class="nr-pdp-delivery__main">
      <svg
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M2.5 5.5h9v8h-9zM11.5 8.5h3.2l2.8 2.8v2.2h-6M5.5 15.5a1.5 1.5 0 1 0 0-.01M14 15.5a1.5 1.5 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
      </svg>
      <span>
        {%- if delivery_text != blank -%}{{ delivery_text | escape }}{%- endif -%}
        {%- if delivery_text != blank and threshold > 0 %} · {% endif -%}
        {%- if threshold > 0 -%}Fri frakt över {{ threshold }} kr{%- endif -%}
      </span>
    </p>
  {%- endif -%}

  {%- if block.settings.return_text != blank or block.settings.show_payment_icons -%}
    <div class="nr-pdp-delivery__sub">
      <span>
        {%- if cart.taxes_included -%}Inkl. moms{%- endif -%}
        {%- if cart.taxes_included and block.settings.return_text != blank %} · {% endif -%}
        {%- if block.settings.return_text != blank -%}{{ block.settings.return_text | escape }}{%- endif -%}
      </span>
      {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <span class="nr-pdp-delivery__payments">
          <span class="visually-hidden">Betalningsalternativ</span>
          {%- for type in shop.enabled_payment_types limit: 5 -%}
            {{ type | payment_type_svg_tag: class: 'nr-pdp-delivery__icon' }}
          {%- endfor -%}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NR PDP: Leverans",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Leveranstid och gräns för fri frakt hämtas från Temainställningar → Frakt & leverans."
    },
    {
      "type": "text",
      "id": "return_text",
      "label": "Returtext",
      "default": "14 dagars ångerrätt"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Visa betalningsikoner",
      "default": true
    }
  ]
}
{% endschema %}
