{%- doc -%}
  NordicReflection bundle recommendation.

  A single reusable block that shows one bundle/kit recommendation inside
  the product-info column, positioned after price/quantity/add-to-cart/
  trust-info and before the accordion/complementary-products content —
  never above the primary purchase.

  Fully data-driven: the merchant picks a real product for `bundle_product`
  (the kit itself — its own price/inventory/variant is the single source of
  truth for what gets added to cart) and up to four real `component_product`
  references purely for the thumbnail row and the "separat" price
  comparison. No hardcoded prices or product data. Leaving `bundle_product`
  empty hides the whole block — the merchant's way to turn it off per
  product without deleting it.

  @example
  {% content_for 'block', type: 'nr-bundle-recommendation', id: 'nr-bundle' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign bundle_product = block_settings.bundle_product
%}

{% if bundle_product != blank %}
  {% liquid
    assign bundle_variant = bundle_product.selected_or_first_available_variant
    assign bundle_available = bundle_variant.available

    assign component_count = 0
    assign separat_total = 0

    if block_settings.component_product_1 != blank
      assign component_count = component_count | plus: 1
      assign separat_total = separat_total | plus: block_settings.component_product_1.selected_or_first_available_variant.price
    endif
    if block_settings.component_product_2 != blank
      assign component_count = component_count | plus: 1
      assign separat_total = separat_total | plus: block_settings.component_product_2.selected_or_first_available_variant.price
    endif
    if block_settings.component_product_3 != blank
      assign component_count = component_count | plus: 1
      assign separat_total = separat_total | plus: block_settings.component_product_3.selected_or_first_available_variant.price
    endif
    if block_settings.component_product_4 != blank
      assign component_count = component_count | plus: 1
      assign separat_total = separat_total | plus: block_settings.component_product_4.selected_or_first_available_variant.price
    endif

    assign show_savings = false
    if component_count > 0 and separat_total > bundle_variant.price
      assign show_savings = true
    endif

    assign cta_label = block_settings.cta_label | default: 'Välj paketet'
  %}

  <div
    class="nr-bundle{% if bundle_available == false %} nr-bundle--soldout{% endif %}"
    {{ block.shopify_attributes }}
  >
    {% if block_settings.eyebrow != blank %}
      <p class="nr-bundle__eyebrow">{{ block_settings.eyebrow }}</p>
    {% endif %}

    {% if block_settings.heading != blank %}
      <h3 class="nr-bundle__heading">{{ block_settings.heading }}</h3>
    {% else %}
      <h3 class="nr-bundle__heading">{{ bundle_product.title }}</h3>
    {% endif %}

    {% if component_count > 0 %}
      <ul
        class="nr-bundle__thumbs"
        role="list"
      >
        {% for i in (1..4) %}
          {% liquid
            case i
              when 1
                assign comp = block_settings.component_product_1
              when 2
                assign comp = block_settings.component_product_2
              when 3
                assign comp = block_settings.component_product_3
              when 4
                assign comp = block_settings.component_product_4
            endcase
          %}
          {% if comp != blank %}
            <li class="nr-bundle__thumb">
              {% if comp.featured_media != blank %}
                {{
                  comp.featured_media
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    width: 80,
                    height: 80,
                    alt: comp.title,
                    class: 'nr-bundle__thumb-image'
                }}
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if block_settings.description != blank %}
      <p class="nr-bundle__description">{{ block_settings.description }}</p>
    {% endif %}

    {% if component_count > 0 %}
      <p class="nr-bundle__count">
        {{ component_count }} produkter
      </p>
    {% endif %}

    <div class="nr-bundle__price-row">
      {% if show_savings %}
        <span class="nr-bundle__price nr-bundle__price--compare">
          Separat: {{ separat_total | money }}
        </span>
      {% endif %}
      <span class="nr-bundle__price nr-bundle__price--bundle">
        Paket: {{ bundle_variant.price | money }}
      </span>
    </div>

    {% if bundle_available %}
      {% assign bundle_form_id = 'NrBundleForm-' | append: block.id %}
      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ bundle_product.id }}"
        data-product-url="{{ bundle_product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>
        {% form 'product', bundle_product, id: bundle_form_id, data-type: 'add-to-cart-form' %}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ bundle_variant.id }}"
          >
          <input
            type="hidden"
            name="quantity"
            value="1"
          >
          {% render 'add-to-cart-button',
            can_add_to_cart: true,
            add_to_cart_text: cta_label,
            product: bundle_product,
            class: 'nr-bundle__cta'
          %}
        {% endform %}
      </product-form-component>
    {% else %}
      <button
        type="button"
        class="button nr-bundle__cta"
        disabled
      >
        {{ 'products.product.sold_out' | t }}
      </button>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .nr-bundle {
    margin-block-start: 28px;
    padding: 20px;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.1);
    border-radius: var(--style-border-radius-popover, 12px);
    background: var(--color-background);
  }

  .nr-bundle__eyebrow {
    margin: 0 0 6px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
  }

  .nr-bundle__heading {
    margin: 0 0 14px;
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-foreground);
  }

  .nr-bundle__thumbs {
    display: flex;
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  .nr-bundle__thumb {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.04);
  }

  .nr-bundle__thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nr-bundle__description {
    margin: 0 0 8px;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.7);
  }

  .nr-bundle__count {
    margin: 0 0 14px;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.5);
  }

  .nr-bundle__price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-block-end: 16px;
    font-family: var(--font-body--family);
  }

  .nr-bundle__price--compare {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.45);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .nr-bundle__price--bundle {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .nr-bundle__cta {
    width: 100%;
  }

  .nr-bundle--soldout .nr-bundle__heading,
  .nr-bundle--soldout .nr-bundle__description {
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .nr-bundle {
      margin-block-start: 20px;
      padding: 16px;
    }

    .nr-bundle__thumb {
      width: 44px;
      height: 44px;
    }

    .nr-bundle__heading {
      font-size: 1rem;
      margin-block-end: 10px;
    }

    .nr-bundle__thumbs {
      margin-block-end: 10px;
    }

    .nr-bundle__description {
      font-size: 0.8125rem;
    }

    .nr-bundle__count {
      margin-block-end: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
