    {
      "type": "header",
      "content": "Innehåll (valfritt, för bilder + prisjämförelse)"
    },
    {
      "type": "product",
      "id": "component_product_1",
      "label": "Produkt 1"
    },
    {
      "type": "product",
      "id": "component_product_2",
      "label": "Produkt 2"
    },
    {
      "type": "product",
      "id": "component_product_3",
      "label": "Produkt 3"
    },
    {
      "type": "product",
      "id": "component_product_4",
      "label": "Produkt 4"
    }
  ],
  "presets": [
    {
      "name": "NR: Bundle-rekommendation",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
