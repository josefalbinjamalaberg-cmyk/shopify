{%- doc -%}
  Kit PDP system – purchase column (decision zone), everything above the buy
  button:
    NordicReflection Trustpilot line (brand trust, links to #NrPdpTrust)
    → kit category (e.g. EXTERIÖR · START) → kit name → one sentence
    → price → Köpta separat → Du sparar → max three points.
  The buy buttons (native Horizon block) and the delivery line (nr-pdp-delivery,
  global shipping settings) follow as their own blocks.

  Data
    price      product's selected/first variant
    separate   snippets/nr-ks-separate (component variants × qty, minus an
               active automatic discount; never compare-at)
    copy       block settings per kit; fallbacks: custom.kit_eyebrow,
               custom.kit_display_title, custom.kit_tagline
  Loads nr-pdp.css + nr-pdp.js (shared with the standard PDP: trust line,
  delivery line, 58/42 hero, analytics, section entrance) and nr-kitsys.css.
{%- enddoc -%}

{{ 'nr-pdp.css' | asset_url | stylesheet_tag }}
{{ 'nr-kitsys.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'nr-pdp.js' | asset_url }}"
  type="module"
  defer
></script>

{%- liquid
  assign kit = closest.product
  if request.visual_preview_mode and kit == blank
    assign kit = collections.all.products.first
  endif

  assign eyebrow = block.settings.eyebrow | default: kit.metafields.custom.kit_eyebrow.value
  assign title = block.settings.title | default: kit.metafields.custom.kit_name.value | default: kit.metafields.custom.kit_display_title.value | default: kit.title
  assign value_line = block.settings.value_line | default: kit.metafields.custom.kit_tagline.value
  assign kit_price = kit.selected_or_first_available_variant.price

  capture separate_total
    render 'nr-ks-separate', product: kit
  endcapture
  assign separate_total = separate_total | strip | plus: 0
  assign saving = 0
  if separate_total > kit_price
    assign saving = separate_total | minus: kit_price
  endif

  assign rating = settings.nr_trustpilot_rating
-%}

<div
  class="nr-pdp-intro nr-ks-intro"
  data-nr-pdp-product="{{ kit.handle | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if rating != blank -%}
    <a
      class="nr-pdp-trustline"
      href="#NrPdpTrust"
      data-nr-event="trustpilot_click"
      data-nr-source="kit_intro"
    >
      <span class="nr-pdp-trustline__brand">NordicReflection</span>
      {% render 'nr-pdp-stars' %}
      <span class="nr-pdp-trustline__score">
        {{- rating | replace: '.', ',' | escape }}/5 på Trustpilot
      </span>
      <span class="nr-pdp-trustline__cta">
        Omdömen om butiken <span aria-hidden="true">&rarr;</span>
      </span>
    </a>
  {%- endif -%}

  {%- if eyebrow != blank -%}
    <p class="nr-ks-label nr-ks-intro__eyebrow">{{ eyebrow | escape }}</p>
  {%- endif -%}

  <h1 class="nr-ks-intro__title">{{ title | escape }}</h1>

  {%- if value_line != blank -%}
    <p class="nr-ks-intro__value">{{ value_line | escape }}</p>
  {%- endif -%}

  <p class="nr-ks-price">
    <span class="nr-ks-price__amount">
      <span class="visually-hidden">Paketpris </span>
      {{- kit_price | money -}}
    </span>
    {%- if saving > 0 -%}
      <span class="nr-ks-price__separate">Köpta separat: {{ separate_total | money }}</span>
      <span class="nr-ks-price__saving">Du sparar {{ saving | money }}</span>
    {%- endif -%}
  </p>

  {%- liquid
    assign has_points = false
    if block.settings.point_1 != blank or block.settings.point_2 != blank or block.settings.point_3 != blank
      assign has_points = true
    endif
  -%}
  {%- if has_points -%}
    <ul
      class="nr-ks-points"
      role="list"
    >
      {%- for i in (1..3) -%}
        {%- capture key %}point_{{ i }}{% endcapture -%}
        {%- assign point = block.settings[key] -%}
        {%- if point != blank -%}
          <li>
            <svg
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ point | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NR Kit: beslutszon",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Pris, Köpta separat och Du sparar räknas från paketets komponenter (custom.kit_components). Trustpilot-betyget hämtas från temainställningen NordicReflection – Trustpilot."
    },
    { "type": "text", "id": "eyebrow", "label": "Kategori", "info": "T.ex. EXTERIÖR · START. Tomt = Paket – överrubrik." },
    { "type": "text", "id": "title", "label": "Namn", "info": "Tomt = Paket – visningsrubrik." },
    { "type": "text", "id": "value_line", "label": "En mening", "info": "Vem kitet är för. Tomt = Paket – värdemening." },
    { "type": "text", "id": "point_1", "label": "Punkt 1" },
    { "type": "text", "id": "point_2", "label": "Punkt 2" },
    { "type": "text", "id": "point_3", "label": "Punkt 3" }
  ],
  "presets": [{ "name": "NR Kit: beslutszon", "category": "Product" }]
}
{% endschema %}
