{%- doc -%}
  Kit page (v3): up to three short contents points (custom.kit_value_points),
  directly under the buy buttons. The one-line contents summary
  (custom.kit_descriptor) is shown once, above the button, by nr-kitpage-summary.
{%- enddoc -%}

{%- liquid
  assign kit = closest.product
  assign points = kit.metafields.custom.kit_value_points.value
-%}

{%- if points != blank -%}
  <div
    class="nr-kp-summary nr-kp-summary--points"
    {{ block.shopify_attributes }}
  >
    {%- if points != blank -%}
      <ul
        class="nr-kp-points"
        role="list"
      >
        {%- for point in points limit: 3 -%}
          <li>
            {%- render 'nr-kit-check' -%}
            <span>{{ point | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR Kit: fördelar",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Hämtas från paketets metafält Paket – snabba fördelar (max tre)." }
  ],
  "presets": [{ "name": "NR Kit: fördelar", "category": "Product" }]
}
{% endschema %}
