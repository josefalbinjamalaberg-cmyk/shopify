{%- doc -%}
  Kit page (v3): contents line (custom.kit_descriptor) and up to three short
  points (custom.kit_value_points), placed directly under the buy buttons.
{%- enddoc -%}

{%- liquid
  assign kit = closest.product
  assign descriptor = kit.metafields.custom.kit_descriptor.value
  assign points = kit.metafields.custom.kit_value_points.value
-%}

{%- if descriptor != blank or points != blank -%}
  <div
    class="nr-kp-summary nr-kp-summary--points"
    {{ block.shopify_attributes }}
  >
    {%- if descriptor != blank -%}
      <p class="nr-kp-summary__descriptor">{{ descriptor | escape }}</p>
    {%- endif -%}
    {%- if points != blank -%}
      <ul
        class="nr-kp-points"
        role="list"
      >
        {%- for point in points limit: 3 -%}
          <li>
            {%- render 'nr-kit-check' -%}
            <span>{{ point | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NR Kit: innehåll & fördelar",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Hämtas från paketets metafält Paket – innehållsrad och Paket – snabba fördelar (max tre)." }
  ],
  "presets": [{ "name": "NR Kit: innehåll & fördelar", "category": "Product" }]
}
{% endschema %}
