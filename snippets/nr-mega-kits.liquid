{%- doc -%}
  Mega-menu panel for "Färdiga paket": the kits in up to three named groups
  (e.g. Exteriör / Fälg & däck / Interiör), each kit as a compact row with
  whole photo, name, price and what it saves versus buying its products
  separately. One kit can carry a badge (e.g. "Bästsäljande kit").
  Styling is shared (snippets/nr-mega-styles).

  Resource settings must be resolved by the caller (see mega-menu-wash-steps).

  @param {string} heading - Panel heading.
  @param {string} [subheading] - Short line under the heading.
  @param {string} [view_all_url] - URL for the "view all" link.
  @param {string} [view_all_label] - Label for the "view all" link.
  @param {string} [group_1_title..group_3_title] - Group headings.
  @param {object} [group_1_products..group_3_products] - Kits per group (product_list).
  @param {object} [badge_product] - The kit that gets the badge.
  @param {string} [badge_text] - Badge text.
{%- enddoc -%}

{% render 'nr-mega-styles' %}

{%- liquid
  assign group_1_count = group_1_products.size | default: 0
  assign group_2_count = group_2_products.size | default: 0
  assign group_3_count = group_3_products.size | default: 0
  assign group_count = 0
  if group_1_count > 0
    assign group_count = group_count | plus: 1
  endif
  if group_2_count > 0
    assign group_count = group_count | plus: 1
  endif
  if group_3_count > 0
    assign group_count = group_count | plus: 1
  endif
-%}

<div class="nr-mm nr-mm--kits">
  <div class="nr-mm__head">
    <div>
      <p
        class="nr-mm__heading"
        role="heading"
        aria-level="2"
      >
        {{ heading }}
      </p>
      {% if subheading != blank %}
        <p class="nr-mm__subheading">{{ subheading }}</p>
      {% endif %}
    </div>
    {% if view_all_url != blank %}
      <a
        href="{{ view_all_url }}"
        class="nr-mm__all"
      >
        {{- view_all_label | default: 'Se alla färdiga paket' -}}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>

  {% if group_count > 0 %}
    <div
      class="nr-mm__groups"
      style="--nr-mm-groups: {{ group_count }};"
    >
      {% for g in (1..3) %}
        {% liquid
          case g
            when 1
              assign group_title = group_1_title
              assign group_products = group_1_products
              assign group_size = group_1_count
            when 2
              assign group_title = group_2_title
              assign group_products = group_2_products
              assign group_size = group_2_count
            when 3
              assign group_title = group_3_title
              assign group_products = group_3_products
              assign group_size = group_3_count
          endcase
        %}
        {% if group_size > 0 %}
          {% assign group_id = 'NrMegaKits-' | append: g %}
          <section
            class="nr-mm__group"
            {% if group_title != blank %}
              aria-labelledby="{{ group_id }}"
            {% endif %}
          >
            {% if group_title != blank %}
              <p
                class="nr-mm__group-title"
                id="{{ group_id }}"
              >
                {{ group_title }}
              </p>
            {% endif %}
            <ul
              class="nr-mm__rows"
              role="list"
            >
              {% for kit in group_products %}
                {% liquid
                  assign kit_badge = ''
                  if badge_product != blank and kit.id == badge_product.id
                    assign kit_badge = badge_text
                  endif
                %}
                <li>{% render 'nr-mega-kit-row', kit: kit, badge: kit_badge %}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .nr-mm-row__badge {
    color: var(--nr-mm-text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
{% endstylesheet %}
