{%- doc -%}
  Mobile "Tvätta bilen steg för steg" routine view for the header drawer.

  Renders a Horizon drill-down: a <details> whose <summary> (markup supplied
  by the caller) opens a .menu-drawer__submenu panel with the 8-step routine
  and the Exteriör Komplett Kit CTA. Open, back, close, Escape and focus trap
  are handled by the existing header-drawer.js via
  on:click="header-drawer/open/submenu" and on:click="header-drawer/back".

  Used twice by nr-mobile-nav.liquid: from the dark feature block on the main
  menu (back → "Meny") and from the Exteriör panel (back → "Exteriör").

  Product links, names and the kit reuse the SAME block settings that feed the
  desktop mega menu (exterior_step_N_product, exterior_step_N_name,
  exterior_promo_*). Only the short mobile copy (exterior_mobile_*,
  exterior_step_N_mobile_label) is mobile-specific.

  @param {object} block - The _header-menu block (source of settings).
  @param {string} uid - Unique suffix for element ids.
  @param {string} back_label - Text of the back button.
  @param {string} summary_class - Classes for the <summary>.
  @param {string} summary_content - Inner HTML of the <summary>.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign panel_heading = bs.exterior_panel_heading | default: 'Tvätta bilen steg för steg'
  assign panel_heading_html = panel_heading | escape | replace: ' steg för steg', '<br>steg för steg' | replace: ' Steg för steg', '<br>Steg för steg'
  assign kit_product = bs.exterior_promo_product
  if kit_product != blank and kit_product.url == blank
    assign kit_product = all_products[kit_product]
  endif
-%}

{%- capture nr_arrow -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg>
{%- endcapture -%}

<details
  id="Details-nr-wash-{{ uid }}"
  class="nr-wash-drawer"
>
  <summary
    id="NrWash-{{ uid }}"
    class="{{ summary_class }}"
    on:click="header-drawer/open/submenu"
  >
    {{- summary_content -}}
  </summary>

  <div
    id="NrWashPanel-{{ uid }}"
    class="menu-drawer__submenu has-submenu nr-mnav__panel nr-wash-drawer__panel"
    tabindex="-1"
  >
    <div class="menu-drawer__inner-submenu nr-mnav__panel-inner">
      {% render 'nr-mobile-nav-bar', back_label: back_label %}

      <div class="nr-wash-drawer__head">
        <h2 class="nr-wash-drawer__heading">{{ panel_heading_html }}</h2>
        {%- if bs.exterior_mobile_intro != blank -%}
          <p class="nr-wash-drawer__intro">{{ bs.exterior_mobile_intro | escape }}</p>
        {%- endif -%}
      </div>

      <ol
        class="nr-wash-drawer__steps"
        role="list"
      >
        {%- for i in (1..8) -%}
          {%- liquid
            case i
              when 1
                assign step_product = bs.exterior_step_1_product
                assign step_name = bs.exterior_step_1_name
                assign step_desc = bs.exterior_step_1_mobile_label | default: bs.exterior_step_1_label
              when 2
                assign step_product = bs.exterior_step_2_product
                assign step_name = bs.exterior_step_2_name
                assign step_desc = bs.exterior_step_2_mobile_label | default: bs.exterior_step_2_label
              when 3
                assign step_product = bs.exterior_step_3_product
                assign step_name = bs.exterior_step_3_name
                assign step_desc = bs.exterior_step_3_mobile_label | default: bs.exterior_step_3_label
              when 4
                assign step_product = bs.exterior_step_4_product
                assign step_name = bs.exterior_step_4_name
                assign step_desc = bs.exterior_step_4_mobile_label | default: bs.exterior_step_4_label
              when 5
                assign step_product = bs.exterior_step_5_product
                assign step_name = bs.exterior_step_5_name
                assign step_desc = bs.exterior_step_5_mobile_label | default: bs.exterior_step_5_label
              when 6
                assign step_product = bs.exterior_step_6_product
                assign step_name = bs.exterior_step_6_name
                assign step_desc = bs.exterior_step_6_mobile_label | default: bs.exterior_step_6_label
              when 7
                assign step_product = bs.exterior_step_7_product
                assign step_name = bs.exterior_step_7_name
                assign step_desc = bs.exterior_step_7_mobile_label | default: bs.exterior_step_7_label
              when 8
                assign step_product = bs.exterior_step_8_product
                assign step_name = bs.exterior_step_8_name
                assign step_desc = bs.exterior_step_8_mobile_label | default: bs.exterior_step_8_label
            endcase

            # Defensive: if a product setting ever reaches this snippet as a
            # bare handle instead of a resolved product, look it up by handle.
            if step_product != blank and step_product.url == blank
              assign step_product = all_products[step_product]
            endif

            assign step_number = i | prepend: '0' | slice: -2, 2
          -%}
          {%- if step_product != blank and step_product.url != blank -%}
            <li class="nr-wash-drawer__step-item">
              <a
                href="{{ step_product.url }}"
                class="nr-wash-drawer__step"
                {% if step_product.url == request.path %}
                  aria-current="page"
                {% endif %}
              >
                <span
                  class="nr-wash-drawer__num"
                  aria-hidden="true"
                >
                  {{- step_number -}}
                </span>
                <span class="nr-wash-drawer__body">
                  <span class="nr-wash-drawer__name">{{ step_name | default: step_product.title | escape }}</span>
                  {%- if step_desc != blank -%}
                    <span class="nr-wash-drawer__desc">{{ step_desc | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="nr-mnav__arrow">{{- nr_arrow -}}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>

      {%- if kit_product != blank and kit_product.url != blank -%}
        <a
          href="{{ kit_product.url }}"
          class="nr-mnav__kit"
        >
          {%- if bs.exterior_mobile_cta_eyebrow != blank -%}
            <span class="nr-mnav__kit-eyebrow">{{ bs.exterior_mobile_cta_eyebrow | escape }}</span>
          {%- endif -%}
          <span class="nr-mnav__kit-title">
            {{- bs.exterior_promo_heading | default: kit_product.title | escape -}}
          </span>
          {%- liquid
            assign cta_text = bs.exterior_mobile_cta_text | default: bs.exterior_promo_text
          -%}
          {%- if cta_text != blank -%}
            <span class="nr-mnav__kit-text">{{ cta_text | escape }}</span>
          {%- endif -%}
          <span class="nr-mnav__kit-button">
            <span>{{ bs.exterior_promo_button_label | default: 'Se paketet' | escape }}</span>
            {{- nr_arrow -}}
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</details>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    /* Header */
    .nr-wash-drawer__head {
      padding: 24px 20px 16px;
    }

    .nr-wash-drawer__heading {
      margin: 0;
      font-family: var(--font-heading--family, inherit);
      font-size: 24px;
      font-weight: 650;
      line-height: 1.12;
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: var(--color-foreground);
    }

    .nr-wash-drawer__intro {
      margin: 8px 0 0;
      font-size: 14.5px;
      line-height: 1.45;
      color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
    }

    /* Steps */
    .nr-wash-drawer__steps {
      list-style: none;
      margin: 0;
      padding: 0 20px;
    }

    .nr-wash-drawer__step-item {
      border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
    }

    .nr-wash-drawer__step-item:last-child {
      border-bottom: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
    }

    .nr-wash-drawer__step {
      display: grid;
      grid-template-columns: 26px minmax(0, 1fr) auto;
      column-gap: 12px;
      align-items: center;
      min-height: 64px;
      padding-block: 13px;
      color: var(--color-foreground);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    .nr-wash-drawer__num {
      align-self: start;
      font-size: 11.5px;
      font-weight: 500;
      line-height: 20px;
      letter-spacing: 0.06em;
      font-variant-numeric: tabular-nums;
      color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.4);
    }

    .nr-wash-drawer__body {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .nr-wash-drawer__name {
      font-size: 15px;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      overflow-wrap: anywhere;
    }

    .nr-wash-drawer__desc {
      font-size: 13.5px;
      line-height: 1.35;
      color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
      overflow-wrap: break-word;
    }

    .nr-wash-drawer__step:active .nr-wash-drawer__name {
      opacity: 0.7;
    }

    .nr-wash-drawer__step[aria-current='page'] .nr-wash-drawer__num {
      color: var(--color-foreground);
    }
  }
{% endstylesheet %}
