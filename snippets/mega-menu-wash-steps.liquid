{%- doc -%}
  Renders the "wash order" mega-menu panel for the Exteriör navigation item:
  the eight products in the confirmed wash order as numbered cards (whole
  product photo, "Steg N", name, what it does, price), and a promo card for
  the bundled kit with its price and what it saves versus buying the
  products separately. Styling is shared with the other panels
  (snippets/nr-mega-styles).

  Resource-type settings (product pickers) must be resolved by the caller
  and passed in as already-resolved objects — Shopify only auto-resolves
  `block.settings.<product_field>` at the literal call site, not when a
  settings object is passed through and read inside a different snippet.

  @param {string} [heading] - Panel heading.
  @param {string} [subheading] - Panel subheading.
  @param {string} [all_products_url] - URL for the "all products" link.
  @param {string} [all_products_label] - Label for the "all products" link.
  @param {object} [step_1_product..step_8_product] - Resolved product for each step.
  @param {string} [step_1_name..step_8_name] - Display name for each step.
  @param {string} [step_1_label..step_8_label] - What the step's product does.
  @param {string} [step_1_nav_label..step_8_nav_label] - Unused (kept so the caller needn't change).
  @param {string} [promo_badge] - Promo card badge text.
  @param {object} [promo_product] - Promo card's linked product.
  @param {string} [promo_heading] - Promo card heading.
  @param {string} [promo_text] - Promo card body text.
  @param {object} [promo_image] - Promo card image (falls back to promo_product's image).
  @param {string} [promo_button_label] - Promo card button label.
  @param {number} [image_border_radius] - Unused; the panel follows the site's radius.
{%- enddoc -%}

{% render 'nr-mega-styles' %}

{% liquid
  assign heading = heading | default: 'Tvätta bilen steg för steg'
  assign promo_button_label = promo_button_label | default: 'Se paketet'
  assign has_promo = false
  if promo_product != blank or promo_heading != blank
    assign has_promo = true
  endif
%}

<div class="nr-mm nr-mm--steps">
  <div class="nr-mm__layout{% if has_promo %} nr-mm__layout--aside{% endif %}">
    <div class="nr-mm__main">
      <div class="nr-mm__head">
        <div>
          <p
            class="nr-mm__heading"
            role="heading"
            aria-level="2"
          >
            {{ heading }}
          </p>
          {% if subheading != blank %}
            <p class="nr-mm__subheading">{{ subheading }}</p>
          {% endif %}
        </div>
        {% if all_products_url != blank %}
          <a
            href="{{ all_products_url }}"
            class="nr-mm__all"
          >
            {{- all_products_label | default: 'Alla produkter' -}}
            <span aria-hidden="true">&rarr;</span>
          </a>
        {% endif %}
      </div>

      <ol
        class="nr-mm__grid"
        style="--nr-mm-cols: 4;"
      >
        {% for i in (1..8) %}
          {% liquid
            case i
              when 1
                assign step_product = step_1_product
                assign step_name = step_1_name
                assign step_label = step_1_label
              when 2
                assign step_product = step_2_product
                assign step_name = step_2_name
                assign step_label = step_2_label
              when 3
                assign step_product = step_3_product
                assign step_name = step_3_name
                assign step_label = step_3_label
              when 4
                assign step_product = step_4_product
                assign step_name = step_4_name
                assign step_label = step_4_label
              when 5
                assign step_product = step_5_product
                assign step_name = step_5_name
                assign step_label = step_5_label
              when 6
                assign step_product = step_6_product
                assign step_name = step_6_name
                assign step_label = step_6_label
              when 7
                assign step_product = step_7_product
                assign step_name = step_7_name
                assign step_label = step_7_label
              when 8
                assign step_product = step_8_product
                assign step_name = step_8_name
                assign step_label = step_8_label
            endcase
          %}
          {% if step_product != blank %}
            <li>
              <a
                href="{{ step_product.url }}"
                class="nr-mm-card"
                {% # theme-check-disable UnknownFilter %}
                view-event-payload="{{ step_product | standard_event_data: 'view', context: 'dialog' | escape }}"
                {% # theme-check-enable UnknownFilter %}
              >
                <span class="nr-mm-card__media">
                  {%- if step_product.featured_image != blank -%}
                    {{
                      step_product.featured_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400',
                        sizes: '(min-width: 1280px) 180px, 150px',
                        class: 'nr-mm-card__image',
                        alt: ''
                    }}
                  {%- endif -%}
                </span>
                <span class="nr-mm-card__body">
                  <span
                    class="nr-mm-eyebrow"
                    aria-hidden="true"
                  >
                    Steg {{ i -}}
                  </span>
                  <span class="nr-mm-name">
                    <span class="visually-hidden">Steg {{ i }}: </span>
                    {{- step_name | default: step_product.title -}}
                  </span>
                  {%- if step_label != blank -%}
                    <span class="nr-mm-text">{{- step_label -}}</span>
                  {%- endif -%}
                  <span class="nr-mm-price">{{- step_product.price | money -}}</span>
                </span>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>

    {% if has_promo %}
      {%- liquid
        assign promo_saving = 0
        if promo_product != blank
          capture promo_separate
            render 'nr-kit-separate-total', product: promo_product
          endcapture
          assign promo_separate = promo_separate | strip | plus: 0
          if promo_separate > promo_product.price
            assign promo_saving = promo_separate | minus: promo_product.price
          endif
        endif
        assign promo_img = promo_image | default: promo_product.featured_image
      -%}
      <aside
        class="nr-mm-aside"
        aria-label="{{ promo_heading | default: promo_product.title | escape }}"
      >
        {% if promo_badge != blank %}
          <span class="nr-mm-badge">{{ promo_badge }}</span>
        {% endif %}
        <div class="nr-mm-promo">
          {% if promo_img != blank %}
            <span class="nr-mm-row__media nr-mm-promo__media">
              {{
                promo_img
                | image_url: width: 240
                | image_tag:
                  loading: 'lazy',
                  widths: '120, 180, 240',
                  sizes: '96px',
                  class: 'nr-mm-row__image',
                  alt: ''
              }}
            </span>
          {% endif %}
          <div>
            {% if promo_heading != blank %}
              <p class="nr-mm-aside__title">{{ promo_heading }}</p>
            {% endif %}
            {% if promo_text != blank %}
              <p class="nr-mm-aside__text">{{ promo_text }}</p>
            {% endif %}
          </div>
        </div>
        {% if promo_product != blank %}
          <p class="nr-mm-promo__price">
            <span class="nr-mm-promo__price-now">{{ promo_product.price | money }}</span>
            {%- if promo_saving > 0 -%}
              <span class="nr-mm-text">Köpta separat: {{ promo_separate | money }}</span>
            {%- endif -%}
          </p>
          {%- if promo_saving > 0 -%}
            <p class="nr-mm-promo__saving">Du sparar {{ promo_saving | money }}</p>
          {%- endif -%}
          <a
            href="{{ promo_product.url }}"
            class="nr-mm-button"
          >
            <span>{{- promo_button_label -}}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        {% endif %}
      </aside>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .nr-mm-promo {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
  }

  .nr-mm-promo__media {
    width: 96px;
    height: 96px;
    background: #fff;
  }

  .nr-mm-promo__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin: 0;
  }

  .nr-mm-promo__price-now {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--nr-mm-text);
  }

  .nr-mm-promo__saving {
    margin: -4px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--nr-mm-text);
  }
{% endstylesheet %}
