{%- doc -%}
  Renders the "wash order" mega-menu panel for the Exteriör navigation item:
  the eight products in the confirmed wash order as compact numbered rows
  (image, name, what it does, price), and a promo card for the bundled kit
  with its price and what it saves versus buying the products separately.

  Sized to fit a 1280×800 / 1366×768 laptop screen without scrolling: the
  panel is two rows of four on wide screens and two columns below 1280px.

  Resource-type settings (product pickers) must be resolved by the caller
  and passed in as already-resolved objects — Shopify only auto-resolves
  `block.settings.<product_field>` at the literal call site, not when a
  settings object is passed through and read inside a different snippet.

  @param {string} [heading] - Panel heading.
  @param {string} [subheading] - Panel subheading.
  @param {string} [all_products_url] - URL for the "all products" link.
  @param {string} [all_products_label] - Label for the "all products" link.
  @param {object} [step_1_product..step_8_product] - Resolved product for each step.
  @param {string} [step_1_name..step_8_name] - Display name for each step.
  @param {string} [step_1_label..step_8_label] - What the step's product does.
  @param {string} [step_1_nav_label..step_8_nav_label] - Unused since the left
    navigation column was removed; still accepted so the caller needn't change.
  @param {string} [promo_badge] - Promo card badge text.
  @param {object} [promo_product] - Promo card's linked product.
  @param {string} [promo_heading] - Promo card heading.
  @param {string} [promo_text] - Promo card body text.
  @param {object} [promo_image] - Promo card image (falls back to promo_product's image).
  @param {string} [promo_button_label] - Promo card button label.
  @param {number} [image_border_radius] - Unused; the panel follows the site's radius.
{%- enddoc -%}

{% liquid
  assign heading = heading | default: 'Tvätta bilen steg för steg'
  assign promo_button_label = promo_button_label | default: 'Se paketet'
%}

<div class="nr-wash-menu">
  <div class="nr-wash-menu-layout">
    <div class="nr-wash-main">
      <div class="nr-wash-main__head">
        <div>
          <p
            class="nr-wash-main__heading"
            role="heading"
            aria-level="2"
          >
            {{ heading }}
          </p>
          {% if subheading != blank %}
            <p class="nr-wash-main__subheading">{{ subheading }}</p>
          {% endif %}
        </div>
        {% if all_products_url != blank %}
          <a
            href="{{ all_products_url }}"
            class="nr-wash-main__all"
          >
            {{- all_products_label | default: 'Alla produkter' -}}
            <span aria-hidden="true">&rarr;</span>
          </a>
        {% endif %}
      </div>

      <ol class="nr-wash-grid">
        {% for i in (1..8) %}
          {% liquid
            case i
              when 1
                assign step_product = step_1_product
                assign step_name = step_1_name
                assign step_label = step_1_label
              when 2
                assign step_product = step_2_product
                assign step_name = step_2_name
                assign step_label = step_2_label
              when 3
                assign step_product = step_3_product
                assign step_name = step_3_name
                assign step_label = step_3_label
              when 4
                assign step_product = step_4_product
                assign step_name = step_4_name
                assign step_label = step_4_label
              when 5
                assign step_product = step_5_product
                assign step_name = step_5_name
                assign step_label = step_5_label
              when 6
                assign step_product = step_6_product
                assign step_name = step_6_name
                assign step_label = step_6_label
              when 7
                assign step_product = step_7_product
                assign step_name = step_7_name
                assign step_label = step_7_label
              when 8
                assign step_product = step_8_product
                assign step_name = step_8_name
                assign step_label = step_8_label
            endcase
          %}
          {% if step_product != blank %}
            <li class="nr-wash-step">
              <a
                href="{{ step_product.url }}"
                class="nr-wash-card"
                {% # theme-check-disable UnknownFilter %}
                view-event-payload="{{ step_product | standard_event_data: 'view', context: 'dialog' | escape }}"
                {% # theme-check-enable UnknownFilter %}
              >
                <span class="nr-wash-card__media">
                  {%- if step_product.featured_image != blank -%}
                    {{
                      step_product.featured_image
                      | image_url: width: 160
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 120, 160',
                        sizes: '64px',
                        class: 'nr-wash-card__image',
                        alt: ''
                    }}
                  {%- endif -%}
                </span>
                <span class="nr-wash-card__body">
                  <span
                    class="nr-wash-card__number"
                    aria-hidden="true"
                  >
                    Steg {{ i -}}
                  </span>
                  <span class="nr-wash-card__title">
                    <span class="visually-hidden">Steg {{ i }}: </span>
                    {{- step_name | default: step_product.title -}}
                  </span>
                  {%- if step_label != blank -%}
                    <span class="nr-wash-card__text">{{- step_label -}}</span>
                  {%- endif -%}
                  <span class="nr-wash-card__price">{{- step_product.price | money -}}</span>
                </span>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>

    {% if promo_product != blank or promo_heading != blank %}
      {%- liquid
        assign promo_saving = 0
        if promo_product != blank
          capture promo_separate
            render 'nr-kit-separate-total', product: promo_product
          endcapture
          assign promo_separate = promo_separate | strip | plus: 0
          if promo_separate > promo_product.price
            assign promo_saving = promo_separate | minus: promo_product.price
          endif
        endif
        assign promo_img = promo_image | default: promo_product.featured_image
      -%}
      <aside
        class="nr-wash-promo"
        aria-label="{{ promo_heading | default: promo_product.title | escape }}"
      >
        {% if promo_badge != blank %}
          <span class="nr-wash-promo__badge">{{ promo_badge }}</span>
        {% endif %}
        <div class="nr-wash-promo__top">
          {% if promo_img != blank %}
            <span class="nr-wash-promo__media">
              {{
                promo_img
                | image_url: width: 240
                | image_tag:
                  loading: 'lazy',
                  widths: '120, 180, 240',
                  sizes: '96px',
                  class: 'nr-wash-promo__image',
                  alt: ''
              }}
            </span>
          {% endif %}
          <div class="nr-wash-promo__body">
            {% if promo_heading != blank %}
              <p class="nr-wash-promo__heading">{{ promo_heading }}</p>
            {% endif %}
            {% if promo_text != blank %}
              <p class="nr-wash-promo__text">{{ promo_text }}</p>
            {% endif %}
          </div>
        </div>
        {% if promo_product != blank %}
          <p class="nr-wash-promo__price">
            <span class="nr-wash-promo__price-now">{{ promo_product.price | money }}</span>
            {%- if promo_saving > 0 -%}
              <span class="nr-wash-promo__price-was">Köpta separat: {{ promo_separate | money }}</span>
            {%- endif -%}
          </p>
          {%- if promo_saving > 0 -%}
            <p class="nr-wash-promo__saving">Du sparar {{ promo_saving | money }}</p>
          {%- endif -%}
          <a
            href="{{ promo_product.url }}"
            class="nr-wash-promo__button"
          >
            <span>{{- promo_button_label -}}</span>
            <span
              class="nr-wash-promo__button-arrow"
              aria-hidden="true"
            >&rarr;</span>
          </a>
        {% endif %}
      </aside>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .nr-wash-menu {
    /* The ancestor `.section--page-width` is a grid with a fixed-width
       center track; span the full row and re-center with a wider cap so the
       panel can use a large desktop screen without touching its edges. */
    grid-column: 1 / -1;
    width: calc(100% - 80px);
    max-width: 1320px;
    margin-inline: auto;

    /* The top-level nav <li> sets `white-space: nowrap` for its label and
       it inherits into this panel; reset it once here. */
    white-space: normal;
    overflow-wrap: break-word;

    --nr-wash-text: var(--color-foreground, #111111);
    --nr-wash-muted: rgb(var(--color-foreground-rgb, 17 17 17) / 0.62);
    --nr-wash-line: rgb(var(--color-foreground-rgb, 17 17 17) / 0.1);
    --nr-wash-soft: #f5f5f2;
  }

  .nr-wash-menu-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(260px, 22%, 300px);
    gap: clamp(32px, 3vw, 56px);
    align-items: start;
  }

  /* ---------- Head ---------- */
  .nr-wash-main {
    min-width: 0;
  }

  .nr-wash-main__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .nr-wash-main__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--nr-wash-text);
  }

  .nr-wash-main__subheading {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--nr-wash-muted);
  }

  .nr-wash-main__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: var(--nr-wash-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .nr-wash-main__all:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  /* ---------- Steps: compact numbered rows, in wash order ---------- */
  .nr-wash-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: row;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nr-wash-step {
    min-width: 0;
  }

  .nr-wash-card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    height: 100%;
    padding: 10px 12px 10px 10px;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--nr-wash-line);
    border-radius: 8px;
    background: #fff;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .nr-wash-card:focus-visible {
    outline: 2px solid var(--nr-wash-text);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .nr-wash-card:hover {
      border-color: rgb(var(--color-foreground-rgb, 17 17 17) / 0.35);
      background: var(--nr-wash-soft);
    }
  }

  .nr-wash-card__number {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    color: var(--nr-wash-muted);
  }

  .nr-wash-card__media {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--nr-wash-soft);
  }

  .nr-wash-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nr-wash-card__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .nr-wash-card__title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--nr-wash-text);
  }

  .nr-wash-card__text {
    font-size: 12px;
    line-height: 1.35;
    color: var(--nr-wash-muted);
  }

  .nr-wash-card__price {
    margin-top: 2px;
    font-size: 13px;
    font-weight: 600;
    color: var(--nr-wash-text);
  }

  /* ---------- Promo: the kit, with price and saving ---------- */
  .nr-wash-promo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 20px;
    background: var(--nr-wash-soft);
    border-radius: 8px;
  }

  .nr-wash-promo__badge {
    align-self: flex-start;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
    background: var(--nr-wash-text);
    border-radius: 4px;
  }

  .nr-wash-promo__top {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
  }

  .nr-wash-promo__media {
    display: block;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border-radius: 4px;
    background: #fff;
  }

  .nr-wash-promo__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nr-wash-promo__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--nr-wash-text);
  }

  .nr-wash-promo__text {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--nr-wash-muted);
  }

  .nr-wash-promo__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin: 0;
  }

  .nr-wash-promo__price-now {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--nr-wash-text);
  }

  .nr-wash-promo__price-was {
    font-size: 13px;
    color: var(--nr-wash-muted);
  }

  .nr-wash-promo__saving {
    margin: -4px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--nr-wash-text);
  }

  .nr-wash-promo__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding-inline: 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-background, #ffffff);
    text-decoration: none;
    background: var(--nr-wash-text);
    border-radius: 4px;
    transition: opacity 200ms ease;
  }

  .nr-wash-promo__button:focus-visible {
    outline: 2px solid var(--nr-wash-text);
    outline-offset: 3px;
  }

  .nr-wash-promo__button-arrow {
    display: inline-flex;
    transition: transform 200ms ease;
  }

  @media (hover: hover) {
    .nr-wash-promo__button:hover {
      opacity: 0.85;
    }

    .nr-wash-promo__button:hover .nr-wash-promo__button-arrow {
      transform: translateX(3px);
    }
  }

  /* ---------- Narrower desktops: two columns, still in order ----------
     Column-major flow keeps 1-4 in the first column and 5-8 in the second,
     so the order reads top to bottom. */
  @media screen and (max-width: 1279px) {
    .nr-wash-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
    }
  }

  @media screen and (max-width: 989px) {
    .nr-wash-menu-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* The mobile drawer has its own navigation and never renders this panel,
     so this only matters if it is ever surfaced below 750px. */
  @media screen and (max-width: 749px) {
    .nr-wash-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }
{% endstylesheet %}
