{%- doc -%}
  NordicReflection – "nästa steg" i varukorgen: högst två frivilliga tillbehör
  till det kunden redan valt, med ett tydligt förstahandsval.

  Rendered inside cart-items-component (drawer + cart page), so it is part of
  the section that Horizon re-renders on every cart change – add, remove and
  quantity changes update or hide the suggestions without extra requests.

  Relations are theme-local (this file), verified against each product's own
  pdp.steps / pdp.faq / pdp.accessories – no global app or product data is
  changed. Format per line:
    trigger handle | suggested handle | reason | equivalent handles (comma) | mode
  mode "add" = one-click add (single-variant products only),
       "view" = link to the product (compatibility must be checked first).

  Never suggests a product that
    - is already in the cart,
    - is a component of a kit in the cart (custom.kit_components),
    - is covered by an equivalent product in the cart (e.g. another wheel brush),
    - is sold out.

  Revolt + Mikrofiber Fälgborste: the brush is never offered next to a loose
  Revolt (Fälg startkit holds both). Instead the kit is linked with its own
  current price; Revolt stays in the cart. When both are already in the cart
  as separate lines, the kit price is compared with what the cart actually
  charges for them (final_price, i.e. after automatic discounts).

  @param {string} context - 'drawer' or 'page'
{%- enddoc -%}

{%- capture relations -%}
revolt-flygrostborttagare|mikrofiber-falgborste|Kom åt smutsen på fälgen – även mellan ekrarna.|deepreach-wheel-brush|add
pure-shampoo-ph-neutralt-bilschampo|wash-pad-mikrofiber|Mjuk mikrofiber för handtvätten med Pure Shampoo.||add
clarity-glasrengoring|glass-towel-glasduk|En glasduk till din glasrengöring.||add
pristine-dack-plastfornyare|dackapplikator|Applicera Pristine jämnt på däcksidan.||add
core-apc-allrengoring|scrub-pad-interior|Arbeta in Core APC i textil, plast och vinyl.||add
foamtastic-hogkoncentrerat-snow-foam|foam-lance-skumlans|Skummar Foamtastic med din högtryckstvätt. Kontrollera anslutningen före köp.||view
{%- endcapture -%}

{%- liquid
  assign kit_handle = 'falg-startkit'
  assign revolt_handle = 'revolt-flygrostborttagare'
  assign brush_handle = 'mikrofiber-falgborste'

  # Everything the cart already covers: products in the cart + components of kits in the cart.
  # Triggers: the same products (kits expanded to their components), as ",a,b,".
  assign covered = '|'
  assign triggers = ''
  assign revolt_line = nil
  assign brush_line = nil
  for item in cart.items
    assign covered = covered | append: item.product.handle | append: '|'
    assign kit_components = item.product.metafields.custom.kit_components.value
    if kit_components != blank
      for component in kit_components
        assign component_handle = component.variant.value.product.handle
        if component_handle != blank
          assign covered = covered | append: component_handle | append: '|'
          assign triggers = triggers | append: component_handle | append: ','
        endif
      endfor
    else
      assign triggers = triggers | append: item.product.handle | append: ','
      if item.product.handle == revolt_handle
        assign revolt_line = item
      elsif item.product.handle == brush_handle
        assign brush_line = item
      endif
    endif
  endfor
  assign triggers = ',' | append: triggers
  assign relation_lines = relations | strip | newline_to_br | split: '<br />'

  # Chosen suggestions: "kind§handle§reason§mode" joined by ¤ (max two).
  assign picks = ''
  assign pick_count = 0
  assign picked = '|'

  assign kit_needle = '|' | append: kit_handle | append: '|'
  assign kit = nil
  unless covered contains kit_needle
    assign kit = all_products[kit_handle]
  endunless

  # 1. Revolt and the brush already in the cart as separate lines → show the kit
  #    only if it is cheaper than what the cart charges for those two units.
  if kit != nil and kit.available and revolt_line != nil and brush_line != nil
    if revolt_line.quantity == 1 and brush_line.quantity == 1
      assign pair_total = revolt_line.final_price | plus: brush_line.final_price
      if kit.price < pair_total
        assign picks = '¤pair§' | append: kit_handle | append: '§' | append: pair_total | append: '§view'
        assign pick_count = 1
        assign picked = picked | append: kit_handle | append: '|' | append: brush_handle | append: '|'
      endif
    endif
  endif

  # Relations are listed in order of relevance: the first missing one becomes the
  # primary suggestion, whatever order the cart lines are in.
  for line in relation_lines
    if pick_count >= 2
    break
    endif
    assign parts = line | strip | split: '|'
    assign trigger_needle = ',' | append: parts[0] | append: ','
    unless triggers contains trigger_needle
      continue
    endunless
    assign suggestion = parts[1]
    assign needle = '|' | append: suggestion | append: '|'
    if covered contains needle or picked contains needle
      continue
    endif
    assign equivalent_found = false
    assign equivalents = parts[3] | split: ','
    for equivalent in equivalents
      assign equivalent_needle = '|' | append: equivalent | append: '|'
      if equivalent != blank and covered contains equivalent_needle
        assign equivalent_found = true
      endif
    endfor
    if equivalent_found
      continue
    endif

    # Loose Revolt without the brush: link the kit instead of a dearer pair.
    if suggestion == brush_handle and revolt_line != nil
      if kit != nil and kit.available
        assign brush = all_products[brush_handle]
        assign separate_full = revolt_line.variant.price | plus: brush.price
        if kit.price < separate_full and picked contains kit_needle
          continue
        elsif kit.price < separate_full
          assign entry = 'kit§' | append: kit_handle | append: '§§view'
          assign picks = picks | append: '¤' | append: entry
          assign pick_count = pick_count | plus: 1
          assign picked = picked | append: kit_handle | append: '|' | append: brush_handle | append: '|'
        endif
      endif
      continue
    endif

    assign suggested_product = all_products[suggestion]
    if suggested_product == nil or suggested_product.available == false
      continue
    endif
    assign mode = parts[4] | strip
    if mode == 'add' and suggested_product.variants.size > 1
      assign mode = 'choose'
    endif
    assign entry = 'item§' | append: suggestion | append: '§' | append: parts[2] | append: '§' | append: mode
    assign picks = picks | append: '¤' | append: entry
    assign pick_count = pick_count | plus: 1
    assign picked = picked | append: suggestion | append: '|'
  endfor

  assign picks = picks | remove_first: '¤' | split: '¤'
-%}

{%- if cart.item_count > 0 and picks.size > 0 -%}
  <section
    class="nr-cart-next nr-cart-next--{{ context | default: 'drawer' }}"
    aria-labelledby="NrCartNext-{{ context | default: 'drawer' }}"
  >
    <h2
      class="nr-cart-next__heading"
      id="NrCartNext-{{ context | default: 'drawer' }}"
    >
      Passar till det du valt
    </h2>
    <ul
      class="nr-cart-next__list"
      role="list"
    >
      {%- for pick in picks -%}
        {%- liquid
          assign p = pick | split: '§'
          assign kind = p[0]
          assign rec = all_products[p[1]]
          assign rec_variant = rec.selected_or_first_available_variant
          assign rec_name = rec.title | split: ' – ' | first | split: ' - ' | first
        -%}
        <li class="nr-cart-next__item{% if forloop.first %} nr-cart-next__item--primary{% endif %}">
          <a
            class="nr-cart-next__media"
            href="{{ rec.url }}"
            tabindex="-1"
            aria-hidden="true"
          >
            {%- if rec.featured_image != blank -%}
              {{
                rec.featured_image
                | image_url: width: 160
                | image_tag: loading: 'lazy', alt: '', widths: '80, 160', sizes: '56px'
              }}
            {%- endif -%}
          </a>
          <div class="nr-cart-next__body">
            <p class="nr-cart-next__name">
              <a
                href="{{ rec.url }}"
                data-nr-cart-rec-click
                data-nr-product="{{ rec.handle }}"
              >
                {{- rec_name | escape -}}
              </a>
            </p>
            {%- case kind -%}
              {%- when 'pair' -%}
                <p class="nr-cart-next__reason">
                  Samma två produkter ingår i paketet för {{ rec.price | money }} – i varukorgen kostar de nu
                  {{ p[2] | money }}. Väljer du paketet kan du ta bort Revolt och fälgborsten.
                </p>
              {%- when 'kit' -%}
                <p class="nr-cart-next__reason">
                  Revolt och Mikrofiber Fälgborste i ett paket. Väljer du paketet kan du ta bort Revolt ur varukorgen.
                </p>
              {%- else -%}
                <p class="nr-cart-next__reason">{{ p[2] | escape }}</p>
            {%- endcase -%}
          </div>
          <div class="nr-cart-next__action">
            <span class="nr-cart-next__price">
              {%- if p[3] == 'choose' -%}Från {% endif -%}
              {{- rec.price | money -}}
            </span>
            {%- if p[3] == 'add' -%}
              <button
                type="button"
                class="nr-cart-next__button"
                data-nr-cart-rec-add
                data-variant-id="{{ rec_variant.id }}"
                data-nr-product="{{ rec.handle }}"
                aria-label="Lägg till {{ rec_name | escape }} i varukorgen"
              >
                Lägg till
              </button>
            {%- else -%}
              <a
                class="nr-cart-next__button nr-cart-next__button--link"
                href="{{ rec.url }}"
                data-nr-cart-rec-click
                data-nr-product="{{ rec.handle }}"
              >
                {%- case p[3] -%}
                  {%- when 'choose' -%}
                    Välj alternativ
                  {%- else -%}
                    {%- if kind == 'item' -%}Se produkt{%- else -%}Se paketet{%- endif -%}
                {%- endcase -%}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    <p
      class="nr-cart-next__status"
      role="status"
      aria-live="polite"
    ></p>
  </section>
  <script
    type="module"
    src="{{ 'nr-cart-next.js' | asset_url }}"
  ></script>
{%- endif -%}

{% stylesheet %}
  .nr-cart-next {
    margin-block: 12px 4px;
    padding: 14px;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
    border-radius: 12px;
  }

  .nr-cart-next__heading {
    margin: 0 0 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .nr-cart-next__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nr-cart-next__item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
  }

  .nr-cart-next__item + .nr-cart-next__item {
    padding-top: 12px;
    border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
  }

  .nr-cart-next__media {
    display: block;
    width: 56px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.04);
  }

  .nr-cart-next__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nr-cart-next__name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .nr-cart-next__name a {
    color: inherit;
    text-decoration: none;
  }

  .nr-cart-next__name a:hover {
    text-decoration: underline;
  }

  .nr-cart-next__reason {
    margin: 2px 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    opacity: 0.8;
  }

  .nr-cart-next__action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .nr-cart-next__price {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Secondary style: the checkout button stays the strongest action. */
  .nr-cart-next__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .nr-cart-next__button:hover {
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.06);
  }

  .nr-cart-next__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .nr-cart-next__button[aria-busy='true'] {
    cursor: progress;
    opacity: 0.6;
  }

  .nr-cart-next__status:empty {
    display: none;
  }

  .nr-cart-next__status {
    margin: 10px 0 0;
    font-size: 0.8125rem;
  }

  /* Narrow drawers: action under the text, aligned with it. */
  @media screen and (max-width: 420px) {
    .nr-cart-next__item {
      grid-template-columns: 56px minmax(0, 1fr);
    }

    .nr-cart-next__action {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Cart page: stays in the items column, next to the summary on desktop. */
  .nr-cart-next--page {
    grid-column: 1;
    margin-block: 20px 0;
  }
{% endstylesheet %}
